DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/buzzify"

# Host routing. Leave all four unset in development: every host then serves everything, "/" goes to /studio, and
# canonical links use http://127.0.0.1:3100. In production set the two hosts (names only, no https://) and the origin.
# PUBLIC_MENU_HOST="menu.buzzify.me"
# STUDIO_HOST="studio.buzzify.me"
# PUBLIC_MENU_ORIGIN="https://menu.buzzify.me"
# PUBLIC_ROOT_REDIRECT="https://buzzify.me"
