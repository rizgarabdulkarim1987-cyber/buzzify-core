# The variables the app reads, with values for local development. Production has its own values, set in the Vercel
# project's environment variables and never in a file or in the repository; docs/deploy/production.md says where each
# one comes from.

# Database. In development: the embedded PostgreSQL that `npm run db:up` starts. In production: DATABASE_URL is Neon's
# pooled connection URL (its host contains "-pooler"), which the app uses; DIRECT_DATABASE_URL is Neon's direct URL, which
# only migrations use (prisma.config.ts prefers it). Leave DIRECT_DATABASE_URL unset on this machine: while it is set,
# `npm run db:migrate` migrates that database instead of the local one.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/buzzify"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST-WITHOUT-POOLER/DATABASE?sslmode=require"

# Host routing. Leave all four unset in development: every host then serves everything, "/" goes to /studio, and
# canonical links use http://127.0.0.1:3100. In production set the two hosts (names only, no https://) and the origin.
# PUBLIC_MENU_HOST="menu.buzzify.me"
# STUDIO_HOST="studio.buzzify.me"
# PUBLIC_MENU_ORIGIN="https://menu.buzzify.me"
# PUBLIC_ROOT_REDIRECT="https://buzzify.me"

# Email. Leave RESEND_API_KEY unset in development: messages are written to .data/mail/ (and the subject and first
# link are logged) instead of being sent. Production refuses to send without a key. EMAIL_FROM must be an address on a
# domain verified in Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Buzzify Studio <studio@buzzify.me>"

# Sign-in (Better Auth). In development both may stay unset: a fixed development secret and http://127.0.0.1:3100 are
# used. In production the secret must be set to 32 characters or more and the URL must be the origin the Studio is
# served on (no path), or the Studio refuses to start its sign-in. Never reuse the secret between environments.
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://127.0.0.1:3100"

# Development sign-in users. When this is set, `npm run db:seed` creates admin@buzzify.test (Super Admin),
# designer@buzzify.test (Designer of ATELIER) and owner@buzzify.test (Owner of ATELIER) with this password. FOR LOCAL
# DEVELOPMENT ONLY: a password written in this file is known to everyone who can read it, so never set it in production
# (the seed stops there, and refuses a database that is not on this machine; see ALLOW_REMOTE_DEV_SEED below, and the
# production deploy check refuses it too). It must meet the Studio's password policy: at least 12 characters, and not a
# common one.
DEV_SEED_PASSWORD="dev-only-change-me-2026"

# The development seeds (`db:seed` with DEV_SEED_PASSWORD set, and `db:seed:load`) refuse to run when DATABASE_URL points
# at any host but this machine (127.0.0.1, localhost, ::1), and `db:seed` also refuses while NODE_ENV is "production".
# Setting this to 1 lifts the host check. DO NOT set it unless you mean to put the shared development password's users,
# or a thousand test restaurants, into that database: never into a client's or a production one.
# The check reads the host the connection really goes to (a host= parameter or PGHOST overrides the URL, and a socket path
# is never counted as this machine), but it cannot tell a loopback address that is a tunnel to a remote database (an SSH
# forward or a proxy) from a local one. With such a tunnel open, do not run the seeds.
# ALLOW_REMOTE_DEV_SEED=1
