generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Daypart {
  BREAKFAST
  LUNCH
  DINNER
  LATE_NIGHT
}

enum PairingSourceType {
  PRODUCT
  CATEGORY
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RestaurantType {
  CAFE
  RESTAURANT
  BAKERY
  FAST_FOOD
  FINE_DINING
  OTHER
  ICE_CREAM
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum ThemeMode {
  DARK
  LIGHT
}

enum NumeralSystem {
  LATN
  ARAB
}

enum AnalyticsEventType {
  MENU_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  UPSELL_IMPRESSION
  UPSELL_ACCEPT
  PAIRING_IMPRESSION
  PAIRING_ADD
  BUNDLE_IMPRESSION
  BUNDLE_ACCEPT
}

/// A client business. It owns branches and menus; everything a guest sees belongs to one of its menus.
model Restaurant {
  id               String           @id @default(cuid())
  /// Shown to staff as `BZ-0001`: the number padded to four digits.
  clientNumber     Int              @unique @default(autoincrement())
  name             String
  type             RestaurantType   @default(RESTAURANT)
  description      String           @default("")
  address          String           @default("")
  city             String           @default("")
  country          String           @default("")
  phone            String           @default("")
  whatsapp         String           @default("")
  /// { instagram?, facebook?, tiktok?, website? }
  socialLinks      Json             @default("{}")
  /// { mon: [["08:00","23:00"]], ... }
  workingHours     Json             @default("{}")
  status           RestaurantStatus @default(ACTIVE)
  notes            String           @default("")
  permissionPolicy Json             @default("{}")
  /// What the restaurant has bought. The default is for rows that existed before plans (they keep every feature); the
  /// Studio always writes a plan when it creates a restaurant.
  plan             PlanTier         @default(PREMIUM)
  /// Features switched on or off for this restaurant beyond its plan: `{ features: { [key]: boolean } }`.
  planExtras       Json             @default("{}")
  /// The platform owner's note on the deal (what was agreed, paid until when). Only Super Admins read it.
  planNote         String           @default("")
  /// The restaurant's logo in its media library; a new menu starts its brand kit with it.
  logoAssetId      String?
  /// A link to the restaurant on a map (https), shown on template menus that show the address.
  mapUrl           String           @default("")
  /// Whether template menus show "Powered by Buzzify". Only a Super Admin changes it.
  showPoweredBy    Boolean          @default(true)
  /// Which product family the business is: food (menu, cashier) or pharmacy. Existing rows are FOOD.
  sector           BusinessSector   @default(FOOD)
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  branches              Branch[]
  menus                 Menu[]
  memberships           Membership[]
  invitations           Invitation[]
  mediaAssets           MediaAsset[]
  designTemplates       DesignTemplate[]
  subscriptions         Subscription[]
  payments              Payment[]
  posSettings           PosSettings?
  posStaffs             PosStaff[]
  posKitchenSections    PosKitchenSection[]
  posPrinters           PosPrinter[]
  posCategorySettings   PosCategorySetting[]
  posProductSettings    PosProductSetting[]
  posAreas              PosArea[]
  posTables             PosTable[]
  posOrders             PosOrder[]
  posOrderLines         PosOrderLine[]
  posCustomerOrders     PosCustomerOrder[]
  posBillCalls          PosBillCall[]
  posDeliveryZones      PosDeliveryZone[]
  posDrivers            PosDriver[]
  posCustomerOrderLines PosCustomerOrderLine[]
  posPayments           PosPayment[]
  posShifts             PosShift[]
  posCashExpenses       PosCashExpense[]
  posSyncOperations     PosSyncOperation[]
  posPaymentReversals   PosPaymentReversal[]
  posCounters           PosCounter[]
  posPaymentLegs        PosPaymentLeg[]
  posSharedDevices      PosSharedDevice[]
  posPinAttempts        PosPinAttempt[]
  posInventoryItems     PosInventoryItem[]
  posSuppliers          PosSupplier[]
  posPurchaseInvoices   PosPurchaseInvoice[]
  posPurchaseLines      PosPurchaseLine[]
  posStockCounts        PosStockCount[]
  posStockMovements     PosStockMovement[]
  posRecipeLines        PosRecipeLine[]
  posComplaints         PosComplaint[]
  posComplaintNotes     PosComplaintNote[]
  posAiPackage          PosAiPackage?
  posAiUsageMonths      PosAiUsageMonth[]
  posAiCalls            PosAiCall[]
  posAiSummaries        PosAiSummary[]
  phSettings            PhSettings?
  phStaffs              PhStaff[]
  phStaffBranches       PhStaffBranch[]
  phCategories          PhCategory[]
  phProducts            PhProduct[]
  phProductUnits        PhProductUnit[]
  phBarcodes            PhBarcode[]
  phProductBranches     PhProductBranch[]
  phPrices              PhPrice[]
  phPriceChangeBatches  PhPriceChangeBatch[]
  phImportBatches       PhImportBatch[]
  phImportRows          PhImportRow[]
  phBatches             PhBatch[]
  phStockBalances       PhStockBalance[]
  phStockMovements      PhStockMovement[]
  phReceipts            PhReceipt[]
  phReceiptLines        PhReceiptLine[]
  phStockCounts         PhStockCount[]
  phStockCountLines     PhStockCountLine[]
  phExpiryActions       PhExpiryAction[]
  phShifts              PhShift[]
  phCashMovements       PhCashMovement[]
  phSales               PhSale[]
  phSaleLines           PhSaleLine[]
  phSaleLineAllocations PhSaleLineAllocation[]
  phPayments            PhPayment[]
  phReturns             PhReturn[]
  phReturnLines         PhReturnLine[]
  phReceiptReprints     PhReceiptReprint[]
  phSuppliers                PhSupplier[]
  phPurchaseOrders           PhPurchaseOrder[]
  phPurchaseOrderLines       PhPurchaseOrderLine[]
  phSupplierInvoices         PhSupplierInvoice[]
  phSupplierInvoiceLines     PhSupplierInvoiceLine[]
  phSupplierPayments         PhSupplierPayment[]
  phSupplierPaymentAllocations PhSupplierPaymentAllocation[]
  phSupplierReturns          PhSupplierReturn[]
  phSupplierReturnLines      PhSupplierReturnLine[]
  phCreditNotes              PhCreditNote[]
  phCreditAllocations        PhCreditAllocation[]
  phIntakeBatches            PhIntakeBatch[]
  phIntakeFiles              PhIntakeFile[]
  phIntakeRows               PhIntakeRow[]
  phAiUsageMonths            PhAiUsageMonth[]
  phAiCalls                  PhAiCall[]
  phAiReservations           PhAiReservation[]
  phTransfers                PhTransfer[]
  phTransferLines            PhTransferLine[]
  phPrescriptions            PhPrescription[]
  phRxAttachments            PhRxAttachment[]
  phControlledEntries        PhControlledEntry[]
  phCustomers                PhCustomer[]
  phCustomerLedger           PhCustomerLedger[]
  phCustomerPayments         PhCustomerPayment[]
  phAiProposals              PhAiProposal[]
  supportAccessGrants   SupportAccessGrant[]

  @@index([name])
  @@index([city])
  @@index([status])
  @@index([plan])
}

/// The plans a restaurant can be on (src/server/domain/entitlements.ts).
enum PlanTier {
  BASIC
  PRO
  PREMIUM
}

model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  address      String     @default("")
  city         String     @default("")
  phone        String     @default("")
  workingHours Json       @default("{}")
  sortOrder    Int        @default(0)
  version      Int        @default(1)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  phStaffBranches   PhStaffBranch[]
  phProductBranches PhProductBranch[]
  phPrices          PhPrice[]
  phStockBalances   PhStockBalance[]
  phStockMovements  PhStockMovement[]
  phReceipts        PhReceipt[]
  phStockCounts     PhStockCount[]
  phExpiryActions   PhExpiryAction[]
  phShifts          PhShift[]
  phSales           PhSale[]
  phReturns         PhReturn[]
  phPurchaseOrders  PhPurchaseOrder[]
  phSupplierReturns PhSupplierReturn[]
  phIntakeBatches   PhIntakeBatch[]
  phTransfersFrom   PhTransfer[] @relation("PhTransferFrom")
  phTransfersTo     PhTransfer[] @relation("PhTransferTo")
  phPrescriptions   PhPrescription[]
  phRxAttachments   PhRxAttachment[]
  phControlledEntries PhControlledEntry[]
  phCustomerPayments PhCustomerPayment[]
  phAiProposals     PhAiProposal[]

  @@unique([restaurantId, id])
  @@index([restaurantId])
}

/// What a guest opens: one slug, one catalog, one brand. The catalog rows are the draft; guests see the live revision.
model Menu {
  id                  String        @id @default(cuid())
  restaurantId        String
  name                String
  slug                String        @unique
  status              MenuStatus    @default(DRAFT)
  statusBeforeArchive MenuStatus?
  liveRevisionId      String?       @unique
  draftHash           String?
  liveHash            String?
  currency            String        @default("USD")
  defaultLocale       String        @default("en")
  locales             String[]
  timezone            String
  numeralSystem       NumeralSystem @default(LATN)
  /// Whether guests get the complaints and suggestions box; read live, never part of a snapshot.
  feedbackEnabled     Boolean       @default(true)
  /// Whether guests see the intro page before the menu, the restaurant's own page, and the wheel of fortune; read live like feedbackEnabled.
  introEnabled        Boolean       @default(false)
  aboutEnabled        Boolean       @default(false)
  wheelEnabled        Boolean       @default(false)
  /// Whether each dish card shows its order and view counts; read live like the switches above, and shown only when the plan holds menu.dishCounts.
  dishCountsEnabled   Boolean       @default(false)
  /// What bulk price changes round to, in minor units; null for the currency's default (0.05 USD, 250 IQD).
  priceStep           Int?
  engineConfig        Json          @default("{}")
  /// { en?: { title, description }, ar?: ..., ckb?: ... }
  seo                 Json          @default("{}")
  notes               String        @default("")
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id])
  liveRevision    MenuRevision?        @relation("LiveRevision", fields: [liveRevisionId], references: [id], onDelete: SetNull)
  revisions       MenuRevision[]       @relation("MenuRevisions")
  slugs           MenuSlug[]
  domains         MenuDomain[]
  brand           BrandConfig?
  intro           MenuIntro?
  about           MenuAbout?
  aboutOffers     AboutOffer[]
  wheel           MenuWheel?
  wheelSlices     WheelSlice[]
  wheelSpins      WheelSpin[]
  viewTotals      ProductViewTotal[]
  viewMarks       ProductViewMark[]
  categories      Category[]
  products        Product[]
  variants        ProductVariant[]
  groups          ModifierGroup[]
  options         ModifierOption[]
  upsellRules     UpsellRule[]
  pairingRules    PairingRule[]
  bundles         Bundle[]
  bundleItems     BundleItem[]
  promotions      Promotion[]
  occasions       Occasion[]
  showcaseCards   ShowcaseCard[]
  schedule        DaypartSchedule[]
  tables          Table[]
  qrCodes         QrCode[]
  importJobs      ImportJob[]
  analyticsEvents AnalyticsEvent[]
  cashierLinks    CashierLink[]
  pairingCodes    CashierPairingCode[]
  posSettings     PosSettings[]

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([name])
}

/// Every slug a menu has ever had, so a retired address is never handed to a different menu.
model MenuSlug {
  slug      String   @id
  /// Null once the menu is deleted: the slug stays reserved as a tombstone.
  menuId    String?
  createdAt DateTime @default(now())
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)

  @@index([menuId])
}

model MenuRevision {
  id            String    @id @default(cuid())
  menuId        String
  number        Int
  schemaVersion Int
  snapshot      Json
  snapshotHash  String
  goLiveAt      DateTime?
  wentLiveAt    DateTime?
  cancelledAt   DateTime?
  createdById   String?
  note          String    @default("")
  /// The media library assets the snapshot shows, so an asset in use by any revision is never deleted.
  assetIds      String[]  @default([])
  createdAt     DateTime  @default(now())
  menu          Menu      @relation("MenuRevisions", fields: [menuId], references: [id], onDelete: Cascade)
  liveOf        Menu?     @relation("LiveRevision")

  @@unique([menuId, number])
  /// The scheduler looks for revisions whose time to go live has come.
  @@index([goLiveAt])
}

model MenuDomain {
  id     String @id @default(cuid())
  menuId String
  host   String @unique
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model BrandConfig {
  id               String    @id @default(cuid())
  menuId           String    @unique
  tokens           Json
  typography       Json
  theme            ThemeMode @default(DARK)
  motionIntensity  String    @default("subtle")
  navStyle         String    @default("rail")
  /// How the category rail moves: grains, drum, flap, deck or plain (see src/lib/rail.ts).
  railStyle        String    @default("grains")
  logoText         String
  /// The logo from the media library (the restaurant's or the shared one), and one for a dark theme when it differs.
  logoAssetId      String?
  logoDarkAssetId  String?
  /// An uploaded favicon, or the logo's rendered PNGs when faviconFromLogo; with neither, the accent mark.
  faviconAssetId   String?
  faviconFromLogo  Boolean   @default(false)
  /// One of the curated pairs in src/lib/font-pairs.ts.
  fontPairId       String    @default("classic")
  /// The template preset the menu is drawn with (src/lib/templates); null keeps the classic menu.
  templateId       String?
  /// What the business changed from its template: `DesignOverrides`, only the fields it changed.
  design           Json      @default("{}")
  /// The custom template last applied, when the design came from one (for the Studio only).
  customTemplateId String?
  version          Int       @default(1)
  menu             Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model Category {
  id                 String              @id @default(cuid())
  menuId             String
  slug               String
  sortOrder          Int                 @default(0)
  translations       Json
  isActive           Boolean             @default(true)
  /// The cart suggests one of its dishes when the order has none ("complete your meal").
  completesMeal      Boolean             @default(false)
  version            Int                 @default(1)
  menu               Menu                @relation(fields: [menuId], references: [id], onDelete: Cascade)
  products           Product[]
  posCategorySetting PosCategorySetting?

  @@unique([menuId, slug])
}

model Product {
  id                 String    @id @default(cuid())
  menuId             String
  categoryId         String
  slug               String
  basePrice          Int
  cost               Int?
  popularity         Int       @default(50)
  priority           Int       @default(50)
  isSignature        Boolean   @default(false)
  isFeatured         Boolean   @default(false)
  isAvailable        Boolean   @default(true)
  /// Hidden from guests without a publish; `isAvailable` is the separate "sold out" state.
  isHidden           Boolean   @default(false)
  stockCount         Int?
  lowStockThreshold  Int?
  dayparts           Daypart[]
  hideOutsideDaypart Boolean   @default(false)
  slot               String?
  allergens          String[]
  dietary            String[]
  calories           Int?
  /// How many people the dish is for, from 2; null for one.
  serves             Int?
  /// NEW, POPULAR or RECOMMENDED.
  badges             String[]
  ingredients        Json      @default("{}")
  media              Json      @default("[]")
  translations       Json
  sortOrder          Int       @default(0)
  version            Int       @default(1)

  menu                  Menu                   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants              ProductVariant[]
  groups                ModifierGroup[]
  upsellFrom            UpsellRule[]           @relation("UpsellSource")
  upsellTo              UpsellRule[]           @relation("UpsellTarget")
  pairingFrom           PairingRule[]          @relation("PairingSource")
  pairingTo             PairingRule[]          @relation("PairingTarget")
  bundleItems           BundleItem[]
  posProductSetting     PosProductSetting?
  posRecipeLines        PosRecipeLine[]
  posOrderLines         PosOrderLine[]
  posCustomerOrderLines PosCustomerOrderLine[]

  @@unique([menuId, slug])
  @@index([menuId, categoryId])
}

model ProductVariant {
  id           String  @id @default(cuid())
  menuId       String
  productId    String
  priceDelta   Int     @default(0)
  costDelta    Int?
  isDefault    Boolean @default(false)
  translations Json
  sortOrder    Int     @default(0)
  version      Int     @default(1)
  menu         Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([menuId, productId])
}

model ModifierGroup {
  id           String           @id @default(cuid())
  menuId       String
  productId    String
  minSelect    Int              @default(0)
  maxSelect    Int              @default(1)
  translations Json
  sortOrder    Int              @default(0)
  version      Int              @default(1)
  menu         Menu             @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options      ModifierOption[]

  @@index([menuId, productId])
}

model ModifierOption {
  id              String        @id @default(cuid())
  menuId          String
  groupId         String
  priceDelta      Int           @default(0)
  costDelta       Int?
  isSuggested     Boolean       @default(false)
  suggestPriority Int           @default(50)
  isAvailable     Boolean       @default(true)
  /// What the option does to the product's 3D model: cheese, patty or bacon. Null means nothing.
  visualKey       String?
  translations    Json
  sortOrder       Int           @default(0)
  version         Int           @default(1)
  menu            Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([menuId, groupId])
}

model UpsellRule {
  id              String    @id @default(cuid())
  menuId          String
  sourceProductId String
  targetProductId String
  priority        Int       @default(50)
  dayparts        Daypart[]
  translations    Json
  isActive        Boolean   @default(true)
  version         Int       @default(1)
  menu            Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  source          Product   @relation("UpsellSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target          Product   @relation("UpsellTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@index([menuId, sourceProductId])
}

model PairingRule {
  id               String            @id @default(cuid())
  menuId           String
  sourceType       PairingSourceType
  sourceProductId  String?
  sourceCategoryId String?
  targetProductId  String
  weight           Int               @default(50)
  dayparts         Daypart[]
  translations     Json
  isActive         Boolean           @default(true)
  version          Int               @default(1)
  menu             Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  source           Product?          @relation("PairingSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target           Product           @relation("PairingTarget", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Bundle {
  id           String       @id @default(cuid())
  menuId       String
  slug         String
  price        Int
  dayparts     Daypart[]
  translations Json
  isActive     Boolean      @default(true)
  version      Int          @default(1)
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items        BundleItem[]

/// How many people the set feeds (shown on its showcase card); null when not stated.
  people       Int?
  showcaseCards ShowcaseCard[]

  @@unique([menuId, slug])
}

model BundleItem {
  id        String  @id @default(cuid())
  menuId    String
  bundleId  String
  productId String
  variantId String?
  quantity  Int     @default(1)
  menu      Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([menuId, bundleId])
}

enum PromotionKind {
  /// A highlight (today's special, a limited-time dish) that changes no price.
  SPECIAL
  /// A percentage off its dishes while it is live (a happy hour).
  DISCOUNT
}

/// A timed offer on some dishes or categories (docs/superpowers/specs/2026-10-18-sales-tools-design.md, 6.1).
model Promotion {
  id           String        @id @default(cuid())
  menuId       String
  kind         PromotionKind
  /// DISCOUNT only: 5 to 90.
  percentOff   Int?
  productIds   String[]
  categoryIds  String[]
  /// Local dates in the menu's time zone, `YYYY-MM-DD`, both inclusive; null is open-ended.
  startsOn     String?
  endsOn       String?
  /// A daily window in minutes after local midnight; both null for all day. It wraps past midnight when end <= start.
  startMinute  Int?
  endMinute    Int?
  /// Bit 0 is Monday, as `DaypartSchedule.daysOfWeek`.
  daysOfWeek   Int           @default(127)
  /// { en: { title, text }, ar: ..., ckb: ... }
  translations Json
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  menu         Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  showcaseCards ShowcaseCard[]

  @@index([menuId])
}

enum ShowcaseSlot {
  /// The carousel above the search bar.
  ABOVE_SEARCH
  /// The carousel below the search bar.
  BELOW_SEARCH
}

enum ShowcaseKind {
  /// A card for one Promotion.
  OFFER
  /// A card for one Bundle (a set meal).
  SET
  /// A free-standing buffet card with its own price and hours.
  BUFFET
}

/// A dated occasion (Eid, Ramadan) whose cards show only between its dates (docs/superpowers/specs/2026-10-30-menu-occasions-showcase-design.md).
model Occasion {
  id           String         @id @default(cuid())
  menuId       String
  /// Local dates in the menu's time zone, `YYYY-MM-DD`, both inclusive.
  startsOn     String
  endsOn       String
  /// { en: { name }, ar: ..., ckb: ... }
  translations Json
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  menu         Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  cards        ShowcaseCard[]

  @@index([menuId])
}

/// One card in a menu showcase carousel; OFFER points at a Promotion, SET at a Bundle, BUFFET carries its own price and hours.
model ShowcaseCard {
  id           String       @id @default(cuid())
  menuId       String
  slot         ShowcaseSlot
  kind         ShowcaseKind
  sortOrder    Int
  isActive     Boolean      @default(true)
  /// Set when the card belongs to an occasion and shows only within its dates.
  occasionId   String?
  promotionId  String?
  bundleId     String?
  /// BUFFET only: integer IQD per person.
  price        Int?
  /// BUFFET only: a daily window in minutes after local midnight; both null for all day. It wraps past midnight when end <= start.
  startMinute  Int?
  endMinute    Int?
  /// Bit 0 is Monday, as `DaypartSchedule.daysOfWeek`.
  daysOfWeek   Int          @default(127)
  /// { en: { title, text }, ar: ..., ckb: ... }
  translations Json
  version      Int          @default(1)
  createdAt    DateTime     @default(now())
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  occasion     Occasion?    @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  promotion    Promotion?   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  bundle       Bundle?      @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([menuId, slot])
}

model DaypartSchedule {
  id          String  @id @default(cuid())
  menuId      String
  daypart     Daypart
  startMinute Int
  endMinute   Int
  daysOfWeek  Int     @default(127)
  menu        Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Table {
  id     String @id @default(cuid())
  menuId String
  number Int
  label  String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, number])
}

enum ImportStatus {
  PARSED
  APPLIED
  DISCARDED
  FAILED
}

/// A sheet read for an import (spec 13.2): its preview, kept until it is applied or discarded.
model ImportJob {
  id           String       @id @default(cuid())
  menuId       String
  fileName     String
  status       ImportStatus @default(PARSED)
  /// `ImportPreview` (src/server/domain/import-sheet.ts).
  preview      Json
  rowCount     Int
  /// The draft the preview compared with: applying it to a draft that changed since is refused.
  draftHash    String
  hideMissing  Boolean      @default(false)
  /// An AI reading from a link: the pictures to give the new products it creates, by category slug and lower-case name, as asset ids.
  photos       Json?
  /// English text to its Arabic and Sorani Kurdish, worked out by the AI after a reading from a link; given to the products and categories the import creates.
  translations Json?
  createdById  String?
  appliedAt    DateTime?
  createdAt    DateTime     @default(now())
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, createdAt])
}

/// A printed QR code: for the menu, or for one table. Its scans are menu views that carry its id.
model QrCode {
  id          String   @id @default(cuid())
  menuId      String
  label       String
  /// The table it opens, or null for a code that opens the menu itself.
  tableNumber Int?
  /// Colours, logo and frame text (`QrStyle` in src/server/domain/qr.ts).
  style       Json     @default("{}")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, tableNumber])
  @@index([menuId])
}

model AnalyticsEvent {
  id                 String             @id @default(cuid())
  menuId             String
  anonymousSessionId String
  type               AnalyticsEventType
  tableNumber        Int?
  productId          String?
  suggestionId       String?
  /// Which printed QR code the guest scanned, when the menu was opened from one.
  qrCodeId           String?
  /// Where the guest came from: a QR code, a link or a search.
  source             String?
  payload            Json               @default("{}")
  occurredAt         DateTime           @default(now())
  menu               Menu               @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, type, occurredAt])
  @@index([type, occurredAt])
}

/// The two roles held inside a restaurant. Super Admin is a flag on the user, not a role.
enum MemberRole {
  DESIGNER
  OWNER
}

/// A person who signs in to the Studio (Better Auth's table). Accounts are created by invitation only.
model User {
  id                  String               @id
  name                String
  /// Lower case and trimmed, unique.
  email               String
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  twoFactorEnabled    Boolean?             @default(false)
  isSuperAdmin        Boolean              @default(false)
  /// The one account that sells: only it changes plans. At most one row is true (a partial unique index in the
  /// migration), and it counts only while the person is a Super Admin.
  isPlatformOwner     Boolean              @default(false)
  /// The language of the Studio and of the emails sent to this person: en, ar or ckb.
  locale              String               @default("en")
  /// The look this person chose for the Studio and the till (src/lib/appearance.ts); null until they choose. Read only through parseStoredAppearance.
  appearance          Json?
  /// Set when the person is switched off. They keep their history but have no actor and no session.
  deactivatedAt       DateTime?
  sessions            Session[]
  accounts            Account[]
  twofactors          TwoFactor[]
  memberships         Membership[]
  invitationsSent     Invitation[]
  posStaffs           PosStaff[]
  phStaffs            PhStaff[]
  supportAccessGrants SupportAccessGrant[] @relation("SupportGrantee")
  posShifts           PosShift[]
  posCashExpenses     PosCashExpense[]
  posPayments         PosPayment[]
  posReversals        PosPaymentReversal[]

  @@unique([email])
  @@map("user")
}

model Session {
  id              String   @id
  expiresAt       DateTime
  token           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ipAddress       String?
  userAgent       String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set only on a session made by PIN sign-in: the shared device and the restaurant it belongs to. Revoking the device
  /// or clearing the PIN ends these sessions, and the till works in this restaurant whatever else the person joined.
  posDeviceId     String?
  posRestaurantId String?

  @@unique([token])
  @@index([userId])
  @@index([posDeviceId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// Better Auth's own limiter for requests that arrive over HTTP. The Studio's Server Actions use `AuthRateLimit`.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

/// The role a person holds in a restaurant. Read by user across restaurants, so it is not tenant-scoped.
model Membership {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  role         MemberRole
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

/// An offer to join the Studio, sent by email and accepted from the link in it. Global: a staff invitation has no
/// restaurant. The link's token is never stored, only its SHA-256 hash, so a copy of this table opens nothing.
model Invitation {
  id           String      @id @default(cuid())
  /// Lower case and trimmed.
  email        String
  /// The restaurant an owner or designer invitation is for; null for a staff invitation.
  restaurantId String?
  /// The membership the invitation creates; null for a staff invitation.
  role         MemberRole?
  /// A staff invitation that makes the person a Super Admin when it is accepted.
  asSuperAdmin Boolean     @default(false)
  /// SHA-256 of the token, in hex.
  tokenHash    String      @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  invitedById  String
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedBy    User        @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([restaurantId])
}

/// A fixed-window counter for the Studio's sign-in, two-factor, reset and invitation limits (`checkRateLimit`).
model AuthRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

/// Who changed what, where and when. The Studio's actions write it in the same transaction as the change. Actor,
/// restaurant and menu are plain ids, not relations, so the history outlives the rows it describes.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  restaurantId String?
  menuId       String?
  /// What was done, such as `restaurant.rename` or `menu.publish`.
  action       String
  entityType   String
  entityId     String
  /// `{ field: { before, after } }`, chosen by the action. Never a request body, a password or a token.
  changes      Json     @default("{}")
  ip           String   @default("")
  userAgent    String   @default("")
  occurredAt   DateTime @default(now())

  @@index([restaurantId, occurredAt])
  @@index([actorId, occurredAt])
  /// The Activity filters by one menu and by one kind of change, newest first (`listActivityRows`).
  @@index([menuId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt])
  /// The newest change to one row, which a refused save names (`updateWithVersion`).
  @@index([entityType, entityId, occurredAt])
}

/// Platform-wide settings, one row per key (`reservedSlugs`, `emailSenderName`, `defaults`; read through
/// `getPlatformSettings`). A global model. A missing or malformed row reads as the built-in default.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  /// The person who last saved it. A plain id, not a relation, so removing the person never blocks the setting.
  updatedById String?
}

/**
 * A message from the Buzzify team to every till and Studio user (spec 2026-10-26, part 4). Written by Super Admins;
 * titles and bodies are { en?, ar?, ckb? }. Shown from startsAt until endsAt (open-ended when null), unless archived.
 */
model Announcement {
  id          String    @id @default(cuid())
  titles      Json
  bodies      Json
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  archivedAt  DateTime?
  /// The project it was written in (a Super Admin's space): "food" for Menu and Cashier, "pharmacy".
  space       String    @default("food")
  /// A plain id, not a relation, so removing the person never removes the announcement.
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([archivedAt, startsAt])
}

/**
 * What a media library file is: a photo or drawing (made into variants), an SVG drawing, or an icon kept as it is.
 */
enum MediaKind {
  IMAGE
  SVG
  ICON
  /// A GLB model, for a template menu's background (Template Studio stage 2).
  MODEL
  /// An MP4 video with a poster frame, for a template menu's background.
  VIDEO
  /// A Lottie animation (JSON, checked to be data only), for a template menu's background.
  LOTTIE
}

/**
 * A file in a media library (spec 11): a restaurant's own, or the shared library when `restaurantId` is null. A
 * restaurant's client reads its own and the shared assets and writes only its own (`RESTAURANT_OR_SHARED_MODELS`). The
 * files live in storage under `storageKey`; a copy for another restaurant (a duplicated menu) is a new row pointing at the
 * same files, so they are deleted only when no row names them.
 */
model MediaAsset {
  id           String      @id @default(cuid())
  /// Null for the shared library.
  restaurantId String?
  kind         MediaKind
  /// The storage folder the files live in: `r/{restaurantId}/{contentHash}` or `shared/{contentHash}`.
  storageKey   String
  /// SHA-256 of the file as uploaded, in hex: the same file uploaded twice to one library is one asset.
  contentHash  String
  mime         String
  /// The size of the upload.
  bytes        Int
  /// Every file written for it: the original and all its variants.
  storedBytes  Int
  width        Int?
  height       Int?
  /// A video's or a Lottie animation's length.
  durationMs   Int?
  /// What a scene file holds: a model's triangles, textures and animations; a video's codec and sound; a Lottie's frame rate and layers.
  meta         Json        @default("{}")
  /// `{ original, avif?: { "320": key, ... }, webp?: { ... }, favicon?: { "32": key, "180": key, "512": key }, poster?: { avif, webp } }`.
  variants     Json        @default("{}")
  /// A tiny blurred WebP as a data URI; empty for icons.
  placeholder  String      @default("")
  /// `{ en?, ar?, ckb? }`.
  alt          Json        @default("{}")
  folder       String      @default("")
  tags         String[]
  /// A plain id, not a relation, so removing the person never removes the file.
  uploadedById String?
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, contentHash])
  @@index([restaurantId, folder])
  @@index([storageKey])
}

/**
 * A saved design: a template preset and the overrides on top of it, to apply to other menus (spec
 * 2026-10-18-template-studio-design.md, 4.3). A restaurant's own, or shared across the platform when `restaurantId` is
 * null (saved by a Super Admin). Applying one copies its overrides into the menu's brand kit; later edits stay apart.
 */
model DesignTemplate {
  id           String      @id @default(cuid())
  /// Null for a template shared across the platform.
  restaurantId String?
  name         String
  /// The preset it starts from (src/lib/templates).
  basePresetId String
  /// `DesignOverrides`.
  overrides    Json        @default("{}")
  /// A plain id, not a relation, so removing the person never removes the template.
  createdById  String?
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Billing: the products a restaurant subscribes to, their prices, and payments recorded by hand (no gateway).
// ---------------------------------------------------------------------------------------------------------------------

enum AppStatus {
  ACTIVE
  DISABLED
}

/// Money is an Int in minor units (IQD has 0 digits, USD has 2) beside one of these.
enum Currency {
  IQD
  USD
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// PAST_DUE is folded into GRACE: the period is over, the restaurant is still served, and payment is awaited.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum SubscriptionEventType {
  STARTED_TRIAL
  ACTIVATED
  RENEWED
  PLAN_CHANGED
  ENTERED_GRACE
  EXPIRED
  CANCELLED
  REACTIVATED
}

/// How the money reached the person who took it. Payments are recorded by hand; the electronic names are labels only.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ZAINCASH
  FIB
  QI_CARD
  OTHER
}

/// A product that can be subscribed to (`menu`, `cashier`).
model Application {
  id        String    @id
  /// { en, ar, ckb }
  name      Json
  status    AppStatus @default(ACTIVE)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  prices        PlanPrice[]
  subscriptions Subscription[]
  appPlans      AppPlan[]
}

model PlanPrice {
  id            String        @id @default(cuid())
  applicationId String
  planCode      String
  currency      Currency
  period        BillingPeriod
  /// Minor units: IQD has 0 digits, USD has 2.
  amountMinor   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, planCode, currency, period])
}

/// What a restaurant has bought of an application. At most one live (TRIAL, ACTIVE or GRACE) row per restaurant and
/// application: a partial unique index in the migration enforces it.
model Subscription {
  id                 String             @id @default(cuid())
  restaurantId       String
  applicationId      String
  planCode           String
  status             SubscriptionStatus
  period             BillingPeriod
  currency           Currency
  /// What this subscription renews at, in minor units, copied from the plan price when it started.
  priceMinor         Int
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  /// The day of the month periods end on, in Asia/Baghdad; set by the first payment.
  anchorDay          Int?
  graceDays          Int                @default(7)
  cancelledAt        DateTime?
  version            Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id])
  application        Application        @relation(fields: [applicationId], references: [id])

  events   SubscriptionEvent[]
  payments Payment[]

  @@index([status, currentPeriodEnd])
  @@index([restaurantId])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  subscriptionId String
  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  data           Json                  @default("{}")
  actorId        String?
  occurredAt     DateTime              @default(now())
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, occurredAt])
}

/// A payment the Super Admin recorded by hand after the money arrived. There is no online payment gateway.
model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  restaurantId   String
  amountMinor    Int
  currency       Currency
  method         PaymentMethod @default(CASH)
  reference      String        @default("")
  paidAt         DateTime
  coversFrom     DateTime
  coversTo       DateTime
  idempotencyKey String        @unique
  recordedById   String
  note           String        @default("")
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id])

  @@index([subscriptionId])
  @@index([restaurantId, paidAt])
}

enum CashierLinkStatus {
  ACTIVE
  REVOKED
}

enum LinkEventType {
  CATALOG_CHANGED
  LINK_REVOKED
  PLAN_CHANGED
}

/// A menu paired with a Buzzify Cashier business (docs/superpowers/specs/2026-10-24-cashier-link-menu-side.md and the
/// cashier repo's link contract). At most one ACTIVE link per menu (a partial unique index in the migration). The
/// secret is stored encrypted (`LINK_ENCRYPTION_KEY`) and is never returned by any API after pairing.
model CashierLink {
  id                  String               @id @default(cuid())
  menuId              String
  status              CashierLinkStatus    @default(ACTIVE)
  /// AES-256-GCM of the shared secret, `base64url(iv | tag | ciphertext)`.
  secretCiphertext    String
  /// The cashier's origin, checked by the SSRF guard when it paired.
  cashierBaseUrl      String
  /// The cashier's Business id: opaque to the menu, shown to staff with the name.
  cashierBusinessRef  String
  cashierBusinessName String
  coreBusinessId      String?
  pairedAt            DateTime             @default(now())
  revokedAt           DateTime?
  lastSeenAt          DateTime?
  menu                Menu                 @relation(fields: [menuId], references: [id], onDelete: Cascade)
  events              CashierLinkEvent[]
  imports             CashierImportBatch[]

  @@index([menuId, status])
}

/// A single-use code the menu owner generates in the Studio and the cashier owner enters; stored hashed.
model CashierPairingCode {
  id          String    @id @default(cuid())
  menuId      String
  /// SHA-256 of the 10-character code, in hex.
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Failed pairing attempts that matched this code; five burn it.
  attempts    Int       @default(0)
  /// A plain id, not a relation, so removing the person never blocks history.
  createdById String?
  createdAt   DateTime  @default(now())
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

/// A nudge for the cashier (`catalog.changed`, `link.revoked`, `plan.changed`), written in the same transaction as the
/// change and delivered after it: once at once, then from the scheduler every minute (contract 6.5). It carries no data.
model CashierLinkEvent {
  id            String        @id @default(cuid())
  linkId        String
  /// The id the cashier de-duplicates by; the same across retries.
  eventId       String        @unique @default(uuid())
  type          LinkEventType
  occurredAt    DateTime      @default(now())
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  deliveredAt   DateTime?
  lastError     String?
  link          CashierLink   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, nextAttemptAt])
  @@index([linkId])
}

/// What an import from the cashier answered, kept so the same `batchKey` returns the first answer (contract 5.4).
model CashierImportBatch {
  id        String      @id @default(cuid())
  linkId    String
  batchKey  String
  result    Json
  createdAt DateTime    @default(now())
  link      CashierLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, batchKey])
}

/// A fixed-window counter for the link API (600 requests a minute per link, pairing attempts per address), in the
/// database so every instance agrees.
model LinkRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

/// The roles of the cashier, separate from the Studio's `MemberRole`.
enum PosRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  CAPTAIN
}

enum PosPaymentMethod {
  CASH
  ZAINCASH
  FIB
  QICARD
  /// Cash in US dollars: the leg's `amount` is the dinars it covers, `tenderedUsd` the dollars handed over.
  CASH_USD
}

/// How one restaurant runs its till: rates, payment methods and the on/off switches of the cashier's features.
model PosSettings {
  id                    String             @id @default(cuid())
  restaurantId          String             @unique
  /// Whole percent added as a service charge.
  serviceRatePercent    Int                @default(0)
  /// Whole percent added as tax.
  taxRatePercent        Int                @default(0)
  enabledPaymentMethods PosPaymentMethod[] @default([CASH])
  kitchenPrintEnabled   Boolean            @default(false)
  kitchenScreenEnabled  Boolean            @default(false)
  qrOrderingEnabled     Boolean            @default(false)
  takeawayEnabled       Boolean            @default(false)
  deliveryEnabled       Boolean            @default(false)
  complaintsEnabled     Boolean            @default(false)
  /// Minutes a table may stay occupied before its ring warns.
  tableRingMinutes      Int                @default(60)
  /// Minutes of no activity before the till signs the person out; 0 turns it off.
  idleMinutes           Int                @default(15)
  /// A cashier's discount, cancel and refund need a manager PIN on the spot.
  requireApproval       Boolean            @default(true)
  /// A guest order waits for a captain's approval before the cashier may take it.
  captainApproval       Boolean            @default(false)
  /// The payable total rounds to the nearest multiple of this many dinars; 0 turns it off.
  roundingStep          Int                @default(0)
  /// Cash in US dollars is accepted at `usdRate` dinars per dollar.
  usdEnabled            Boolean            @default(false)
  usdRate               Int                @default(0)
  /// The business details printed on every receipt.
  invoiceName           String             @default("")
  invoiceAddress        String             @default("")
  invoicePhone          String             @default("")
  invoiceTaxNumber      String             @default("")
  invoiceFooter         String             @default("")
  /// The menu whose rows are this restaurant's product list; null until the cashier is first set up.
  catalogMenuId         String?
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  restaurant            Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  catalogMenu           Menu?              @relation(fields: [catalogMenuId], references: [id], onDelete: SetNull)
}

/// A person who works the till of one restaurant. An OWNER member of the restaurant is its cashier OWNER without a row.
model PosStaff {
  id               String             @id @default(cuid())
  restaurantId     String
  userId           String
  role             PosRole
  deactivatedAt    DateTime?
  /// For a KITCHEN member: the only section whose screen they see. Null sees every section.
  kitchenSectionId String?
  /// scrypt hash of the quick sign-in PIN, never the PIN.
  pinHash          String?
  pinSetAt         DateTime?
  pinFailedCount   Int                @default(0)
  pinLockedUntil   DateTime?
  createdAt        DateTime           @default(now())
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchenSection   PosKitchenSection? @relation(fields: [kitchenSectionId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
}

/// A part of the kitchen with its own screen (grill, cold, bar). A KITCHEN member may be tied to one.
model PosKitchenSection {
  id           String               @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff        PosStaff[]
  categories   PosCategorySetting[]
  products     PosProductSetting[]
  printers     PosPrinter[]

  @@index([restaurantId])
}

/// What only the till knows about a menu category: which kitchen section prepares it.
model PosCategorySetting {
  id           String             @id @default(cuid())
  categoryId   String             @unique
  restaurantId String
  sectionId    String?
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  section      PosKitchenSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// What only the till knows about a menu product: its kitchen section (overriding its category's) and a till-only sold-out switch.
model PosProductSetting {
  id              String             @id @default(cuid())
  productId       String             @unique
  restaurantId    String
  sectionId       String?
  soldOutOverride Boolean            @default(false)
  /// The code printed on the product's pack, scanned at the till. Text so leading zeros survive; unique per restaurant when set (a partial index in the migration).
  barcode         String?
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  section         PosKitchenSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

enum PosPrinterRole {
  RECEIPT
  KITCHEN
}

enum PosPrinterTransport {
  NETWORK
  FILE
}

/// A thermal printer of the restaurant. The bridge program on each till PC reaches it by address.
model PosPrinter {
  id           String              @id @default(cuid())
  restaurantId String
  name         String
  role         PosPrinterRole
  transport    PosPrinterTransport
  /// host:port for NETWORK, a Windows share path for FILE.
  address      String
  /// 58 or 80 (millimetres).
  paperWidth   Int                 @default(80)
  cut          Boolean             @default(true)
  /// The drawer port pin (2 or 5) when a cash drawer hangs off this printer.
  drawerPin    Int?
  /// The printer that takes receipts; at most one per restaurant.
  isDefault    Boolean             @default(false)
  /// A KITCHEN printer for one section; null takes every section without a printer of its own.
  sectionId    String?
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  section      PosKitchenSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
}

enum PosOrderStatus {
  PENDING_APPROVAL
  OPEN
  READY
  BILL_REQUESTED
  PAID
  CANCELLED
  REJECTED
}

enum PosOrderKind {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

/// How far a takeaway or delivery order has come. Null for a dine-in order.
enum PosFulfillment {
  NEW
  PREPARING
  READY
  OUT
  DELIVERED
  PICKED_UP
}

enum PosDiscountKind {
  AMOUNT
  PERCENT
}

/// A part of the floor (hall, terrace) that groups tables.
model PosArea {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       PosTable[]

  @@index([restaurantId])
}

/// A dining table. Its number is the Menu's QR table number (`/t/<n>`), so there is one numbering.
model PosTable {
  id             String             @id @default(cuid())
  restaurantId   String
  areaId         String
  number         Int
  restaurant     Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  area           PosArea            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  orders         PosOrder[]
  customerOrders PosCustomerOrder[]
  billCalls      PosBillCall[]

  @@unique([restaurantId, number])
  @@index([areaId])
}

/// A guest at a table asked for the bill. Unseen until someone at the till or the floor marks it seen.
model PosBillCall {
  id             String     @id @default(cuid())
  restaurantId   String
  tableId        String
  tableNumber    Int
  createdAt      DateTime   @default(now())
  seenAt         DateTime?
  /// Plain id (no relation): the person who marked it seen.
  seenByUserId   String?
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          PosTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, seenAt])
  @@index([tableId, createdAt])
}

/// One bill. At most one live order per table: the partial unique index "PosOrder_one_live_per_table" (raw SQL in the migration).
model PosOrder {
  id                               String             @id @default(cuid())
  restaurantId                     String
  tableId                          String?
  /// Sequence per restaurant.
  number                           Int
  kind                             PosOrderKind       @default(DINE_IN)
  status                           PosOrderStatus     @default(OPEN)
  seatedAt                         DateTime           @default(now())
  invoiceDiscountKind              PosDiscountKind?
  invoiceDiscountValue             Int?
  invoiceDiscountReason            PosDiscountReason?
  invoiceDiscountNote              String?
  invoiceDiscountApprovedByStaffId String?
  /// Takeaway and delivery: the Baghdad day ('YYYY-MM-DD') and the number within it. Null for dine-in.
  queueDay                         String?
  queueNumber                      Int?
  customerName                     String             @default("")
  customerPhone                    String             @default("")
  address                          String             @default("")
  addressNote                      String             @default("")
  /// Plain ids and copies (no relation): a zone or driver edit never changes an order.
  deliveryZoneId                   String?
  deliveryZoneName                 String             @default("")
  /// Integer IQD added after tax; 0 for anything but a delivery.
  deliveryFee                      Int                @default(0)
  driverId                         String?
  driverNameSnapshot               String             @default("")
  fulfillment                      PosFulfillment?
  outAt                            DateTime?
  doneAt                           DateTime?
  /// Optimistic lock: every write to an order or its lines matches it and bumps it by one.
  version                          Int                @default(1)
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
  restaurant                       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                            PosTable?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  lines                            PosOrderLine[]
  /// One payment for the whole bill, or one per guest when the bill was split (`part` 1, 2, 3...).
  payments                         PosPayment[]

  @@unique([restaurantId, number])
  @@unique([restaurantId, queueDay, queueNumber])
  @@index([tableId])
  @@index([restaurantId, status])
  @@index([restaurantId, kind, status])
  @@index([restaurantId, customerPhone])
}

/// A delivery area with its fee, picked when a delivery order is opened.
model PosDeliveryZone {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  /// Integer IQD.
  fee          Int
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// A person who delivers. They never sign in: a name and a phone, nothing more.
model PosDriver {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  phone        String     @default("")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model PosOrderLine {
  id                        String             @id @default(cuid())
  restaurantId              String
  orderId                   String
  productId                 String?
  nameSnapshot              String
  /// Integer IQD: the product's base price when the line was added. Chosen variant and options are in optionsSnapshot.
  unitPriceSnapshot         Int
  quantity                  Int                @default(1)
  note                      String             @default("")
  /// [{ id, name, priceDelta }] of the chosen variant (first) and options, copied when the line was added.
  optionsSnapshot           Json               @default("[]")
  /// Integer IQD per unit: what the menu's live offer took off when the line was added (0: none). Kept apart from the
  /// cashier's own discount, which applies to the price that is left.
  promoDiscountPerUnit      Int                @default(0)
  discountKind              PosDiscountKind?
  discountValue             Int?
  discountReason            PosDiscountReason?
  discountNote              String?
  discountApprovedByStaffId String?
  cancelledAt               DateTime?
  cancelReason              String?
  /// Plain id (no relation): the kitchen section when the line was added; survives a section delete.
  sectionId                 String?
  sectionNameSnapshot       String             @default("")
  sentAt                    DateTime?
  /// The round it was sent in: 1, 2, 3... per order.
  batch                     Int?
  readyAt                   DateTime?
  cancelAckAt               DateTime?
  /// The payment that paid this line; null while unpaid. A paid line can no longer change.
  paymentId                 String?
  createdAt                 DateTime           @default(now())
  restaurant                Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order                     PosOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  payment                   PosPayment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([orderId])
  @@index([paymentId])
  @@index([productId])
  @@index([restaurantId, sentAt])
}

model PosPayment {
  id             String              @id @default(cuid())
  restaurantId   String
  orderId        String
  /// 1 for a bill paid at once; 2, 3... for the next guest's share of a split bill.
  part           Int                 @default(1)
  method         PosPaymentMethod
  /// Integer IQD handed over by the customer.
  amountReceived Int
  reference      String?
  totalsSnapshot Json
  /// Integer IQD left on top of the bill; never part of `totalsSnapshot.total`, so sales reports stay clean.
  tipAmount      Int                 @default(0)
  tipMethod      PosPaymentMethod?
  userId         String?
  shiftId        String?
  paidAt         DateTime            @default(now())
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order          PosOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  shift          PosShift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reversal       PosPaymentReversal?
  legs           PosPaymentLeg[]
  lines          PosOrderLine[]

  @@unique([orderId, part])
  @@index([restaurantId, paidAt])
  @@index([shiftId])
}

/// How much of a payment was taken with one method. A bill paid half cash, half FIB has two legs. The legs' `amount`s add
/// up to the payment's snapshot total.
model PosPaymentLeg {
  id           String           @id @default(cuid())
  restaurantId String
  paymentId    String
  method       PosPaymentMethod
  /// Integer IQD applied to the bill by this method (cash change is not part of it).
  amount       Int
  /// Integer IQD a cash customer handed over (at least `amount`); null for other methods.
  tendered     Int?
  /// Whole US dollars a customer handed over for a CASH_USD leg; null for other methods.
  tenderedUsd  Int?
  /// Dinars per dollar, frozen when a CASH_USD leg was taken (a refund goes back at this rate); null for other methods.
  rate         Int?
  reference    String?
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payment      PosPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, method])
  @@index([restaurantId])
}

/// One person's cash drawer from opening to count. One open shift per person and restaurant: the partial unique index
/// "PosShift_one_open_per_user" (raw SQL in the migration).
model PosShift {
  id                  String               @id @default(cuid())
  restaurantId        String
  userId              String
  openedAt            DateTime             @default(now())
  /// Integer IQD in the drawer when the shift opened. Zero is allowed.
  openingFloat        Int
  closedAt            DateTime?
  /// Plain id (no relation) so it records a manager closing someone else's shift.
  closedByUserId      String?
  countedCash         Int?
  /// Integer IQD the drawer should have held at close, frozen when the shift closed.
  expectedCashAtClose Int?
  /// countedCash minus expectedCashAtClose: positive is over, negative is short.
  difference          Int?
  /// Whole dollars counted in the drawer at close; null when the restaurant takes no dollars (or the shift is open).
  countedUsd          Int?
  expectedUsdAtClose  Int?
  /// countedUsd minus expectedUsdAtClose.
  differenceUsd       Int?
  /// Z report number, per restaurant, given when the shift closes. Null for a shift closed before numbering or still open.
  zNumber             Int?
  note                String               @default("")
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: NoAction)
  payments            PosPayment[]
  expenses            PosCashExpense[]
  reversals           PosPaymentReversal[]

  @@unique([restaurantId, zNumber])
  @@index([restaurantId, openedAt])
  @@index([userId])
}

/// A named running number per restaurant (the Z report number).
model PosCounter {
  restaurantId String
  name         String
  value        Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, name])
}

enum PosDiscountReason {
  MANAGER_DECISION
  REGULAR_GUEST
  COMPLAINT
  STAFF_MEAL
  OTHER
  /// A dish given on the house; always needs a manager's approval.
  COMP
}

/// Cash taken out of the drawer during a shift.
model PosCashExpense {
  id           String     @id @default(cuid())
  restaurantId String
  shiftId      String
  userId       String
  /// Integer IQD.
  amount       Int
  reason       String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shift        PosShift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([shiftId])
  @@index([restaurantId, createdAt])
}

/// One operation a till device queued while offline, applied exactly once: the action and this row commit together.
model PosSyncOperation {
  id           String     @id @default(cuid())
  restaurantId String
  /// Plain id (no relation): the person whose till sent it.
  userId       String
  deviceId     String
  /// The client's uuid: the idempotency key, unique per restaurant.
  operationId  String
  kind         String
  /// sha256 of the canonical payload: the same id with another payload is refused.
  payloadHash  String
  /// What the action answered, stored in the same transaction; a repeat of the operation answers this.
  result       Json
  clientAt     DateTime
  appliedAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, operationId])
  @@index([restaurantId, appliedAt])
}

enum PosCustomerOrderStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A guest's order from the Menu's table page, waiting for the cashier. Separate from `PosOrder`, so the one-live-order-per-table
/// index and the order state machine are untouched. A request older than 60 minutes is expired on read, not by a job.
model PosCustomerOrder {
  id                      String                 @id @default(cuid())
  restaurantId            String
  tableId                 String
  /// The Menu's table number when the guest sent it.
  tableNumber             Int
  /// Random and unguessable: the guest reads the request's status with it.
  publicId                String                 @unique @default(cuid())
  status                  PosCustomerOrderStatus @default(PENDING)
  customerNote            String                 @default("")
  locale                  String
  rejectReason            String                 @default("")
  /// Plain id (no relation): the order the request became or joined.
  orderId                 String?
  decidedAt               DateTime?
  /// Plain id (no relation): the person who accepted or rejected it.
  decidedByUserId         String?
  /// True when placed while captain approval was on: the cashier may not accept it until a captain approves.
  requiresCaptain         Boolean                @default(false)
  captainApprovedAt       DateTime?
  /// Plain id (no relation): the captain, manager or owner who approved it.
  captainApprovedByUserId String?
  /// Plain id (no relation): the captain who placed it by mouth at the table; null for a guest's own request.
  createdByUserId         String?
  createdAt               DateTime               @default(now())
  restaurant              Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table                   PosTable               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  lines                   PosCustomerOrderLine[]

  @@index([restaurantId, status])
  @@index([tableId, status, createdAt])
  @@index([restaurantId, createdAt])
}

model PosCustomerOrderLine {
  id                   String           @id @default(cuid())
  restaurantId         String
  requestId            String
  productId            String?
  nameSnapshot         String
  /// Integer IQD: the product's base price when the guest ordered. The variant and options are in optionsSnapshot.
  unitPriceSnapshot    Int
  /// [{ id, name, priceDelta }] of the chosen variant (first) and options.
  optionsSnapshot      Json             @default("[]")
  /// Integer IQD per unit the Menu's promotions took off (base + options minus the quoted unit price); 0 for none.
  promoDiscountPerUnit Int              @default(0)
  quantity             Int
  note                 String           @default("")
  restaurant           Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  request              PosCustomerOrder @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([restaurantId])
}

/// A full reversal of one payment, recorded as a counter-entry under the reverser's name. One per payment; the payment
/// row is never edited. It counts in the shift where it was recorded.
model PosPaymentReversal {
  id                String           @id @default(cuid())
  restaurantId      String
  paymentId         String           @unique
  orderId           String
  method            PosPaymentMethod
  /// Integer IQD: the payment's snapshot total.
  amount            Int
  /// Integer IQD of `amount` that went back out of the drawer: the payment's cash legs (0 when none were cash).
  cashPart          Int              @default(0)
  /// Free text copied from the terminal for a terminal method.
  reference         String?
  reason            String
  /// Plain id (no relation): the manager who approved a cashier's refund.
  approvedByStaffId String?
  userId            String?
  shiftId           String?
  createdAt         DateTime         @default(now())
  restaurant        Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payment           PosPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  shift             PosShift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([shiftId])
}

/// A till device a manager registered for quick PIN sign-in. Only the sha256 of its cookie token is stored.
model PosSharedDevice {
  id              String     @id @default(cuid())
  restaurantId    String
  name            String
  tokenHash       String     @unique
  createdByUserId String?
  createdAt       DateTime   @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// One PIN attempt on a device, for the per-device limit. Plain ids; never holds the PIN.
model PosPinAttempt {
  id           String     @id @default(cuid())
  restaurantId String
  deviceId     String
  staffId      String
  ok           Boolean
  at           DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
  @@index([staffId, at])
}

enum PosStockUnit {
  GRAM
  MILLILITER
  PIECE
}

enum PosStockMovementKind {
  PURCHASE
  PURCHASE_VOID
  SALE
  ADJUSTMENT
  WASTE
  COUNT
}

enum PosSupplierPayMethod {
  CASH
  BANK
  ZAINCASH
  FIB
  QICARD
  OTHER
}

enum PosComplaintStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum PosComplaintCategory {
  FOOD
  SERVICE
  CLEANLINESS
  PRICE
  OTHER
  SUGGESTION
}

/// An ingredient or supply. `onHand` changes only in the same transaction as a PosStockMovement, by exactly its quantity.
/// The last cost is lastCostAmount IQD for lastCostQuantity units, both null until the first purchase.
model PosInventoryItem {
  id               String             @id @default(cuid())
  restaurantId     String
  name             String
  nameKey          String
  unit             PosStockUnit
  onHand           Int                @default(0)
  reorderLevel     Int                @default(0)
  active           Boolean            @default(true)
  lastCostAmount   Int?
  lastCostQuantity Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  restaurant       Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements        PosStockMovement[]
  purchaseLines    PosPurchaseLine[]
  recipeLines      PosRecipeLine[]

  @@unique([restaurantId, nameKey])
  @@index([restaurantId, active])
}

model PosSupplier {
  id           String               @id @default(cuid())
  restaurantId String
  name         String
  nameKey      String
  phone        String               @default("")
  notes        String               @default("")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoices     PosPurchaseInvoice[]

  @@unique([restaurantId, nameKey])
}

/// A supplier invoice, posted when saved. Never edited: a wrong one is voided and entered again.
model PosPurchaseInvoice {
  id           String                @id @default(cuid())
  restaurantId String
  supplierId   String
  /// 'YYYY-MM-DD', the date printed on the invoice (a Baghdad calendar day).
  invoiceDay   String
  number       String?
  note         String                @default("")
  /// Integer IQD: the sum of the lines.
  total        Int
  clientKey    String
  paidAt       DateTime?
  paidMethod   PosSupplierPayMethod?
  voidedAt     DateTime?
  voidReason   String?
  /// Plain id (no relation): the person who saved it.
  userId       String?
  createdAt    DateTime              @default(now())
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier     PosSupplier           @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  lines        PosPurchaseLine[]

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, supplierId, number])
  @@index([restaurantId, invoiceDay])
}

model PosPurchaseLine {
  id           String             @id @default(cuid())
  restaurantId String
  invoiceId    String
  itemId       String
  /// In the item's smallest unit.
  quantity     Int
  /// Integer IQD as printed on the invoice.
  lineTotal    Int
  createdAt    DateTime           @default(now())
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice      PosPurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item         PosInventoryItem   @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@index([invoiceId])
  @@index([itemId, createdAt])
}

model PosStockCount {
  id           String             @id @default(cuid())
  restaurantId String
  userId       String?
  note         String             @default("")
  createdAt    DateTime           @default(now())
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements    PosStockMovement[]

  @@index([restaurantId, createdAt])
}

/// The append-only stock ledger. Rows are only ever created. quantity is a signed delta; costTotal is IQD (the line total
/// for a purchase, negated for a void; the last-cost value for a sale or waste; null when unknown). purchaseLineId,
/// paymentId and orderLineId are plain ids so history outlives the rows.
model PosStockMovement {
  id             String               @id @default(cuid())
  restaurantId   String
  itemId         String
  kind           PosStockMovementKind
  quantity       Int
  costTotal      Int?
  reason         String               @default("")
  purchaseLineId String?
  paymentId      String?
  orderLineId    String?
  countId        String?
  userId         String?
  createdAt      DateTime             @default(now())
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  item           PosInventoryItem     @relation(fields: [itemId], references: [id], onDelete: NoAction)
  count          PosStockCount?       @relation(fields: [countId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([itemId, createdAt])
  @@index([paymentId])
}

/// One ingredient of a product, per ONE unit sold. Configuration, not the ledger.
model PosRecipeLine {
  id           String           @id @default(cuid())
  restaurantId String
  productId    String
  itemId       String
  quantity     Int
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  item         PosInventoryItem @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@unique([productId, itemId])
  @@index([restaurantId])
  @@index([itemId])
}

/// A guest complaint or suggestion from a table QR page. The contact is personal data: removable, never audited.
/// tableId and orderId are plain ids (no relation) so a deleted table or order never deletes a complaint.
model PosComplaint {
  id                    String                @id @default(cuid())
  restaurantId          String
  clientKey             String
  status                PosComplaintStatus    @default(NEW)
  category              PosComplaintCategory?
  body                  String
  tableId               String?
  tableNumber           Int?
  orderId               String?
  orderNumber           Int?
  contactName           String?
  contactPhone          String?
  contactConsentAt      DateTime?
  contactRemovedAt      DateTime?
  /// Suggestions by the AI package (phase 9); the customer's own category above is never changed.
  aiCategory            PosComplaintCategory?
  aiSummary             String?
  languageGuess         String?
  aiLabeledAt           DateTime?
  statusChangedAt       DateTime?
  statusChangedByUserId String?
  locale                String                @default("ar")
  createdAt             DateTime              @default(now())
  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  notes                 PosComplaintNote[]

  @@unique([restaurantId, clientKey])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, aiLabeledAt])
  @@index([tableId, createdAt])
}

model PosComplaintNote {
  id           String       @id @default(cuid())
  restaurantId String
  complaintId  String
  userId       String?
  body         String
  createdAt    DateTime     @default(now())
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  complaint    PosComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

/// What the AI package may do for a restaurant. Set by the Super Admin (`pos.setAiPackage`) and read locally on every AI
/// request: Core is never contacted at sale time. `monthlyLimit` 0 with the package on means "no requests left", never "unlimited".
model PosAiPackage {
  restaurantId String     @id
  enabled      Boolean    @default(false)
  monthlyLimit Int        @default(0)
  syncedAt     DateTime?
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

/// AI requests per Baghdad calendar month ('YYYY-MM'). A request is one user-started AI operation.
model PosAiUsageMonth {
  restaurantId String
  month        String
  requests     Int        @default(0)
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, month])
}

enum PosAiFeature {
  ASK
  SUMMARY
  ALERTS
  SUPPLY_ENTRY
  COMPLAINTS
  MENU_IMPORT
}

enum PosAiCallStatus {
  OK
  PROVIDER_ERROR
  TIMEOUT
  REFUSED
  REJECTED_OUTPUT
}

enum PosAiSummaryKind {
  DAILY
  WEEKLY
  MONTHLY
  ALERTS
}

/// Metadata only: never a prompt, an answer, a tool result or a file. staffId is a plain id.
model PosAiCall {
  id           String          @id @default(cuid())
  restaurantId String
  staffId      String?
  feature      PosAiFeature
  model        String
  status       PosAiCallStatus
  inputTokens  Int             @default(0)
  outputTokens Int             @default(0)
  toolCalls    Int             @default(0)
  ms           Int
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

/// A phrased summary or alerts paragraph, reused while the facts it was written from (factsHash) are unchanged.
model PosAiSummary {
  id           String           @id @default(cuid())
  restaurantId String
  kind         PosAiSummaryKind
  periodFrom   String
  periodTo     String
  locale       String
  factsHash    String
  text         String
  model        String
  createdAt    DateTime         @default(now())
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, kind, periodFrom, periodTo, locale])
}

/// Which product family a business is.
enum BusinessSector {
  FOOD
  PHARMACY
}

/// What a person may do in a pharmacy.
enum PhRole {
  OWNER
  BRANCH_MANAGER
  PHARMACIST_IN_CHARGE
  PHARMACIST
  CASHIER
  STOCK
  ACCOUNTANT
}

/// A pharmacy's settings: which currencies it trades in and how long it keeps prescriptions.
model PhSettings {
  id                      String     @id @default(cuid())
  restaurantId            String     @unique
  enabledCurrencies       Currency[] @default([IQD])
  defaultCurrency         Currency   @default(IQD)
  /// Days a prescription is kept; 3650 (10 years) until the owner sets it, null on rows made before phase 7. Nothing is purged. CHECK > 0.
  rxRetentionDays         Int?       @default(3650)
  /// A RESTRICTED (controlled) product may be sold only when this is on (R7-1).
  controlledEnabled       Boolean    @default(false)
  /// Most base units of a controlled drug in one sale line; 0 = no limit. CHECK >= 0.
  controlledMaxQty        Int        @default(30)
  /// A sale may be paid on credit to a customer only when this is on (R7-5).
  creditEnabled           Boolean    @default(false)
  /// Printing: margins and label sizes per workstation (validated by the application, R7-8).
  print                   Json?
  /// Invoice rounding step in minor units of the sale's currency; 0 = none. CHECK >= 0 in the migration.
  roundingStepMinor       BigInt     @default(0)
  /// A discount up to this percent needs `discount.apply`; above it `discount.over_limit` plus a reason. CHECK 0..100.
  maxDiscountPercent      Int        @default(5)
  /// A shift variance above this (absolute, minor units) needs an approver. CHECK >= 0.
  shiftVarianceLimitMinor BigInt     @default(0)
  /// Days after a sale in which a return needs no OWNER/BRANCH_MANAGER. CHECK >= 0.
  returnWindowDays        Int        @default(30)
  /// IANA time zone for what is printed (receipts); instants stay UTC. Validated as a real zone by the application.
  timeZone                String     @default("Asia/Baghdad")
  version                 Int        @default(1)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  restaurant              Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

/// A person who works in one pharmacy.
model PhStaff {
  id            String     @id @default(cuid())
  restaurantId  String
  userId        String
  role          PhRole
  deactivatedAt DateTime?
  createdAt     DateTime   @default(now())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  branches PhStaffBranch[]

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
}

/// A branch a staff member may work in. The branch must belong to the same restaurant (composite foreign key).
model PhStaffBranch {
  id           String     @id @default(cuid())
  restaurantId String
  staffId      String
  branchId     String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff        PhStaff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: Cascade)

  @@unique([staffId, branchId])
  @@index([restaurantId])
  @@index([branchId])
}

/// How tightly a medicine is controlled: sold freely, on prescription, or on prescription with extra records.
enum PhRxLevel {
  OTC
  RX
  RESTRICTED
}

enum PhPriceChangeStatus {
  PREVIEW
  APPLIED
  CANCELLED
}

enum PhImportStatus {
  UPLOADED
  MAPPED
  PREVIEWED
  COMMITTED
  FAILED
  CANCELLED
}

enum PhImportRowStatus {
  OK
  WARNING
  ERROR
  SKIPPED
  IMPORTED
}

/// A pharmacy's product category. `nameKey` is the normalised name that makes a name unique within one business.
model PhCategory {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  nameKey      String
  createdAt    DateTime    @default(now())
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     PhProduct[]

  @@unique([restaurantId, nameKey])
  @@unique([restaurantId, id])
}

/// A medicine or other product a pharmacy sells. `identityKey` is the normalised identity that stops duplicates;
/// `version` is for optimistic locking.
model PhProduct {
  id               String    @id @default(cuid())
  restaurantId     String
  tradeName        String
  genericName      String    @default("")
  activeIngredient String    @default("")
  strength         String    @default("")
  form             String    @default("")
  manufacturer     String    @default("")
  categoryId       String?
  rxLevel          PhRxLevel @default(OTC)
  requiresCold     Boolean   @default(false)
  storageNote      String    @default("")
  shelfLocation    String    @default("")
  imageAssetId     String?
  identityKey      String
  /// The normalised fields search reads (`searchTextOf`: trade name first, fields joined by `|`), kept by the product
  /// service on every save. A trigram GIN index (pg_trgm, `gin_trgm_ops`) serves `LIKE '%q%'` and `LIKE 'q%'` on it.
  /// The CHECK "PhProduct_searchText_present" (raw SQL in the migration) refuses a new or changed row without it.
  searchText       String    @default("")
  active           Boolean   @default(true)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     PhCategory?        @relation(fields: [restaurantId, categoryId], references: [restaurantId, id], onDelete: Restrict)
  units        PhProductUnit[]
  barcodes     PhBarcode[]
  branches     PhProductBranch[]
  prices       PhPrice[]
  batches      PhBatch[]
  balances     PhStockBalance[]
  movements    PhStockMovement[]
  receiptLines PhReceiptLine[]
  intakeRows   PhIntakeRow[]
  transferLines PhTransferLine[]
  controlledEntries PhControlledEntry[]
  saleLines    PhSaleLine[]
  countLines   PhStockCountLine[]
  purchaseOrderLines PhPurchaseOrderLine[]

  @@unique([restaurantId, identityKey])
  @@unique([restaurantId, id])
  @@index([restaurantId, active, tradeName])
  @@index([restaurantId, categoryId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "PhProduct_searchText_trgm")
}

/// One way a product is packed and sold: level 0 is the base unit (a tablet), higher levels are packs of it. CHECKs
/// (baseQty >= 1; level 0 has baseQty 1) are in the migration.
model PhProductUnit {
  id           String          @id @default(cuid())
  restaurantId String
  productId    String
  level        Int
  label        String
  /// How many base units are in one of this unit.
  baseQty      Int
  sellable     Boolean         @default(true)
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      PhProduct       @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)
  barcodes     PhBarcode[]
  prices       PhPrice[]
  costBatches  PhBatch[]
  receiptLines PhReceiptLine[]
  intakeRows   PhIntakeRow[]
  saleLines    PhSaleLine[]
  purchaseOrderLines PhPurchaseOrderLine[]

  @@unique([productId, level])
  @@unique([productId, id])
  @@index([restaurantId, productId])
}

/// A barcode of one unit. `code` is text so leading zeros survive; `shared` marks a code several products use. A code
/// that is not shared is held once per business: the partial unique index "PhBarcode_one_unshared_code" (raw SQL in the migration).
model PhBarcode {
  id           String        @id @default(cuid())
  restaurantId String
  productId    String
  unitId       String
  code         String
  shared       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      PhProduct     @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)
  unit         PhProductUnit @relation(fields: [productId, unitId], references: [productId, id], onDelete: Cascade)

  @@unique([restaurantId, code, unitId])
  @@index([productId])
}

/// A product's stock thresholds in one branch.
model PhProductBranch {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String
  productId    String
  minQty       Int        @default(0)
  reorderQty   Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: Cascade)
  product      PhProduct  @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@index([restaurantId, productId])
}

/// A sell price for one unit, in minor units of one currency, valid from a date. A null `branchId` is a business-wide
/// price. The client does not branch-scope this model: the price service checks the branch. CHECKs (amountMinor >= 0;
/// validTo after validFrom) are in the migration. `changedById` names the person (kept as text, not a foreign key, so history outlives the account).
/// One row per product unit, branch-or-null and currency is open (validTo null): the partial unique index
/// "PhPrice_one_open_price" (raw SQL in the migration). A row is never updated but to set its validTo once.
model PhPrice {
  id           String        @id @default(cuid())
  restaurantId String
  productId    String
  unitId       String
  branchId     String?
  currency     Currency
  amountMinor  BigInt
  validFrom    DateTime
  validTo      DateTime?
  reason       String        @default("")
  changedById  String
  createdAt    DateTime      @default(now())
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product      PhProduct     @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: Restrict)
  unit         PhProductUnit @relation(fields: [productId, unitId], references: [productId, id], onDelete: Restrict)
  branch       Branch?       @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: Restrict)
  saleLines    PhSaleLine[]

  @@unique([restaurantId, id])
  @@index([restaurantId, productId, unitId, currency, validFrom])
  @@index([restaurantId, validFrom])
}

/// A bulk price change, previewed before it is applied; `previewHash` pins what the person saw.
model PhPriceChangeBatch {
  id           String              @id @default(cuid())
  restaurantId String
  status       PhPriceChangeStatus @default(PREVIEW)
  previewHash  String
  validFrom    DateTime
  /// What the change asks for (branch, currency, products, change, rounding, reason), to work the preview out again.
  change       Json                @default("{}")
  createdById  String
  createdAt    DateTime            @default(now())
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

/// A catalog file import: the file's hash, the column mapping and the preview summary.
model PhImportBatch {
  id           String         @id @default(cuid())
  restaurantId String
  status       PhImportStatus @default(UPLOADED)
  fileSha256   String
  mapping      Json           @default("{}")
  summary      Json           @default("{}")
  createdById  String
  createdAt    DateTime       @default(now())
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rows         PhImportRow[]

  @@unique([restaurantId, id])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, fileSha256])
}

/// One row of an import: as read, as parsed, and the problems found.
model PhImportRow {
  id           String            @id @default(cuid())
  restaurantId String
  batchId      String
  rowNumber    Int
  raw          Json
  parsed       Json              @default("{}")
  issues       Json              @default("[]")
  status       PhImportRowStatus @default(OK)
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  batch        PhImportBatch     @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([restaurantId, batchId, status])
}

enum PhBatchStatus {
  ACTIVE
  RECALLED
  BLOCKED
}

enum PhExpiryPrecision {
  DAY
  MONTH
}

enum PhMovementType {
  RECEIPT
  SALE
  RETURN_IN
  RETURN_QUARANTINE
  ADJUST
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
  SUPPLIER_RETURN
  COUNT
  QUARANTINE_RELEASE
}

enum PhStockBucket {
  AVAILABLE
  RESERVED
  QUARANTINE
  DAMAGED
}

enum PhReceiptStatus {
  DRAFT
  CONFIRMED
  VOID
}

enum PhCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

enum PhCountScope {
  BRANCH
  CATEGORY
  LOCATION
}

enum PhExpiryStatus {
  NEW
  IN_PROGRESS
  MOVED
  DISPOSED
  RETURNED
}

/// One lot of one product, business-wide: identified by (product, lot, expiry date, supplier name). A month-only expiry is
/// stored as the last day of the month with `expiryPrecision` MONTH. The cost is for one `costUnitId` (the unit it was
/// bought in), never a per-base fraction; cost, currency and unit are all set or all null. CHECKs (cost >= 0; the cost
/// triple) are in the migration.
model PhBatch {
  id              String            @id @default(cuid())
  restaurantId    String
  productId       String
  lot             String
  expiryDate      DateTime          @db.Date
  expiryPrecision PhExpiryPrecision @default(DAY)
  supplierName    String            @default("")
  status          PhBatchStatus     @default(ACTIVE)
  unitCostMinor   BigInt?
  costCurrency    Currency?
  costUnitId      String?
  receiptLineId   String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product         PhProduct         @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  costUnit        PhProductUnit?    @relation(fields: [productId, costUnitId], references: [productId, id], onDelete: NoAction)

  balances        PhStockBalance[]
  movements       PhStockMovement[]
  expiryItems     PhExpiryAction[]
  countLines      PhStockCountLine[]
  receiptLines    PhReceiptLine[]
  saleAllocations PhSaleLineAllocation[]
  supplierReturnLines PhSupplierReturnLine[]
  transferLines   PhTransferLine[]
  controlledEntries PhControlledEntry[]

  @@unique([restaurantId, productId, lot, expiryDate, supplierName])
  @@unique([restaurantId, productId, lot, expiryDate])
  @@unique([restaurantId, id])
  @@unique([restaurantId, productId, id])
  @@index([restaurantId, productId])
  @@index([restaurantId, expiryDate])
}

/// What one batch holds in one branch, in four whole-number buckets of the product's base unit. Only `applyMovement`
/// writes it. CHECK >= 0 on each bucket is in the migration. `productId` repeats the batch's, for lookups.
model PhStockBalance {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String
  productId    String
  batchId      String
  available    Int        @default(0)
  reserved     Int        @default(0)
  quarantine   Int        @default(0)
  damaged      Int        @default(0)
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  product      PhProduct  @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  batch        PhBatch    @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([batchId, branchId])
  @@index([restaurantId, branchId, productId])
}

/// An entry in the stock ledger: append-only (a trigger refuses UPDATE and any direct DELETE). The four deltas are signed
/// whole numbers of the base unit; a correction is a new movement whose `reversesId` names the original, once (partial
/// unique index "PhStockMovement_one_reversal"). `userId` is text, not a foreign key, so history outlives the account.
/// `refType`/`refId` link a later sale or transfer. CHECKs (not all deltas zero; a RECEIPT adds to available only) are in
/// the migration.
model PhStockMovement {
  id              String            @id @default(cuid())
  restaurantId    String
  branchId        String
  productId       String
  batchId         String
  type            PhMovementType
  availableDelta  Int               @default(0)
  reservedDelta   Int               @default(0)
  quarantineDelta Int               @default(0)
  damagedDelta    Int               @default(0)
  reason          String            @default("")
  userId          String
  reversesId      String?
  receiptId       String?
  countId         String?
  refType         String?
  refId           String?
  createdAt       DateTime          @default(now())
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch          Branch            @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  product         PhProduct         @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  batch           PhBatch           @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)
  reverses        PhStockMovement?  @relation("PhMovementReversal", fields: [reversesId], references: [id], onDelete: NoAction)
  reversedBy      PhStockMovement[] @relation("PhMovementReversal")
  receipt         PhReceipt?        @relation(fields: [restaurantId, receiptId], references: [restaurantId, id], onDelete: NoAction)
  count           PhStockCount?     @relation(fields: [restaurantId, countId], references: [restaurantId, id], onDelete: NoAction)

  @@index([restaurantId, branchId, productId, createdAt])
  @@index([restaurantId, batchId, createdAt])
  @@index([restaurantId, branchId, createdAt])
  @@index([reversesId])
  @@index([receiptId])
  @@index([countId])
}

/// Goods received into one branch, with the supplier as free text (phase 4 links a supplier record). Idempotent by
/// `clientKey` per business. A receipt is edited while DRAFT, then CONFIRMED once (or VOID before that).
model PhReceipt {
  id            String            @id @default(cuid())
  restaurantId  String
  branchId      String
  status        PhReceiptStatus   @default(DRAFT)
  clientKey     String
  supplierName  String            @default("")
  invoiceRef    String            @default("")
  receivedOn    DateTime          @db.Date
  note          String            @default("")
  createdById   String
  confirmedById String?
  confirmedAt   DateTime?
  voidedAt      DateTime?
  /// Per-branch running number ("R-000001"), assigned when the receipt is confirmed.
  number        String?
  version       Int               @default(1)
  /// Phase 4: the supplier (a business-wide record) and the purchase order this receipt answers, both optional. An order
  /// needs a supplier (CHECK) and is of the receipt's own branch (composite foreign key).
  supplierId      String?
  purchaseOrderId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  supplier      PhSupplier?       @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  purchaseOrder PhPurchaseOrder?  @relation("PhReceiptOrderBranch", fields: [restaurantId, purchaseOrderId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)
  purchaseOrderSupplier PhPurchaseOrder? @relation("PhReceiptOrderSupplier", fields: [restaurantId, purchaseOrderId, branchId, supplierId], references: [restaurantId, id, branchId, supplierId], onDelete: NoAction)
  lines         PhReceiptLine[]
  movements     PhStockMovement[]
  intakeBatch   PhIntakeBatch?
  intakeBatchesOfBranch PhIntakeBatch[] @relation("PhIntakeBatchReceiptBranch")

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id])
  @@unique([restaurantId, id, branchId])
  @@unique([branchId, number])
  @@index([restaurantId, branchId, status, createdAt])
}

/// One line of a receipt: `qty` of `unitId`, `baseQty` the same in base units (the unit's size at the time). CHECKs
/// (qty >= 1; baseQty >= 1; cost >= 0; cost and currency together) are in the migration. `batchId` is set on confirm.
model PhReceiptLine {
  id              String            @id @default(cuid())
  restaurantId    String
  receiptId       String
  lineNo          Int
  productId       String
  unitId          String
  qty             Int
  /// Free units of the same unit, on top of `qty`; `baseQty` counts both.
  bonusQty        Int               @default(0)
  baseQty         Int
  lot             String
  expiryDate      DateTime          @db.Date
  expiryPrecision PhExpiryPrecision @default(DAY)
  unitCostMinor   BigInt?
  costCurrency    Currency?
  /// Confirmed on purpose: a zero cost needs `freeOfCharge`; a past expiry needs `acceptExpired` (goes to quarantine).
  freeOfCharge    Boolean           @default(false)
  acceptExpired   Boolean           @default(false)
  batchId         String?
  /// Phase 4: the order line this receipt line answers, and how much of it (qty + bonus) suppliers' invoices already
  /// cover; the CHECK keeps `invoicedQty` within `qty + bonusQty`.
  purchaseOrderLineId String?
  invoicedQty         Int           @default(0)
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseOrderLine PhPurchaseOrderLine? @relation(fields: [restaurantId, purchaseOrderLineId], references: [restaurantId, id], onDelete: NoAction)
  invoiceLines    PhSupplierInvoiceLine[]
  receipt         PhReceipt         @relation(fields: [restaurantId, receiptId], references: [restaurantId, id], onDelete: Cascade)
  product         PhProduct         @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  unit            PhProductUnit     @relation(fields: [productId, unitId], references: [productId, id], onDelete: NoAction)
  batch           PhBatch?          @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([receiptId, lineNo])
  @@unique([restaurantId, id])
  @@index([restaurantId, productId])
}

/// A stock count of one branch: of everything, a category or a shelf location (`scopeValue`). A blind count hides the
/// expected quantities from the counter until it is submitted.
model PhStockCount {
  id           String             @id @default(cuid())
  restaurantId String
  branchId     String
  status       PhCountStatus      @default(OPEN)
  scope        PhCountScope       @default(BRANCH)
  scopeValue   String             @default("")
  blind        Boolean            @default(false)
  countedById  String
  approvedById String?
  reason       String             @default("")
  note         String             @default("")
  submittedAt  DateTime?
  approvedAt   DateTime?
  version      Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  lines        PhStockCountLine[]
  movements    PhStockMovement[]

  @@unique([restaurantId, id])
  @@index([restaurantId, branchId, status, createdAt])
}

/// What was expected (the available bucket when the count opened) and counted for one batch. CHECKs (both >= 0) are in
/// the migration.
model PhStockCountLine {
  id           String       @id @default(cuid())
  restaurantId String
  countId      String
  productId    String
  batchId      String
  expectedQty  Int
  countedQty   Int?
  /// When the line was last counted (the application clock, as movement.createdAt is): the count's expected quantity is the snapshot plus the movements up to this moment.
  countedAt    DateTime?
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  count        PhStockCount @relation(fields: [restaurantId, countId], references: [restaurantId, id], onDelete: Cascade)
  product      PhProduct    @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  batch        PhBatch      @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([countId, batchId])
  @@index([restaurantId, productId])
}

/// The follow-up on a batch that is expired or near expiry, one row per (batch, branch).
model PhExpiryAction {
  id           String         @id @default(cuid())
  restaurantId String
  branchId     String
  batchId      String
  status       PhExpiryStatus @default(NEW)
  assigneeId   String?
  note         String         @default("")
  updatedById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  batch        PhBatch        @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([batchId, branchId])
  @@index([restaurantId, branchId, status])
}

enum PhSaleStatus {
  HELD
  COMPLETED
  RETURNED_PARTIAL
  RETURNED_FULL
  HOLD_EXPIRED
}

enum PhPaymentMethod {
  CASH
  CARD_MANUAL
  TRANSFER_MANUAL
  /// On the customer's account (R7-5): never touches the drawer. Added in phase 7.
  CREDIT
}

enum PhShiftStatus {
  OPEN
  CLOSED
}

enum PhCashMovementType {
  FLOAT_OPEN
  SALE_CASH
  CHANGE_OUT
  REFUND_CASH
  PAID_IN
  PAID_OUT
  /// A customer's payment of their account in cash (R7-5). Added in phase 7.
  CUSTOMER_PAYMENT
}

/// A cashier's shift at one branch. At most one OPEN shift per user per branch (partial unique index
/// "PhShift_one_open_per_user", raw SQL). A closed shift has `closedAt` and the counted, expected and variance amounts.
/// `userId`/`approvedById` are text, not foreign keys, so history outlives the account. CHECKs are in the migration.
model PhShift {
  id                String        @id @default(cuid())
  restaurantId      String
  branchId          String
  userId            String
  openedAt          DateTime      @default(now())
  closedAt          DateTime?
  openingFloatMinor BigInt        @default(0)
  currency          Currency
  status            PhShiftStatus @default(OPEN)
  countedMinor      BigInt?
  expectedMinor     BigInt?
  varianceMinor     BigInt?
  closeReason       String        @default("")
  approvedById      String?
  /// Who closed the shift (the signed-in actor); null while open and on shifts closed before this column existed.
  closedById        String?
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch            Branch        @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)

  movements        PhCashMovement[] @relation("PhCashMovementShift")
  movementCurrency PhCashMovement[] @relation("PhCashMovementShiftCurrency")
  sales            PhSale[]         @relation("PhSaleShift")
  saleCurrency     PhSale[]         @relation("PhSaleShiftCurrency")
  customerPayments PhCustomerPayment[]
  returns          PhReturn[]       @relation("PhReturnShift")
  returnCurrency   PhReturn[]       @relation("PhReturnShiftCurrency")

  @@unique([restaurantId, id])
  @@unique([id, branchId])
  @@unique([id, currency])
  @@index([restaurantId, branchId, status])
}

/// One signed entry in a shift's cash drawer: money in is positive (FLOAT_OPEN, SALE_CASH, PAID_IN), money out negative
/// (CHANGE_OUT, REFUND_CASH, PAID_OUT). No `branchId` of its own: it is reached through its shift (like receipt lines
/// through the receipt). CHECK on the sign by type is in the migration.
model PhCashMovement {
  id            String             @id @default(cuid())
  restaurantId  String
  shiftId       String
  type          PhCashMovementType
  amountMinor   BigInt
  currency      Currency
  reason        String             @default("")
  refType       String?
  refId         String?
  /// Set by paid in/out so a repeat is idempotent; null for movements the sale/return code writes.
  clientKey     String?
  userId        String
  createdAt     DateTime           @default(now())
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shift         PhShift            @relation("PhCashMovementShift", fields: [restaurantId, shiftId], references: [restaurantId, id], onDelete: NoAction)
  shiftCurrency PhShift            @relation("PhCashMovementShiftCurrency", fields: [shiftId, currency], references: [id, currency], onDelete: NoAction)

  @@unique([restaurantId, clientKey])
  @@index([restaurantId, shiftId, createdAt])
}

/// A sale (or a hold) at one branch, in ONE currency, idempotent by `clientKey` per business. `number` ("20261028-000123",
/// per branch per day) is set when it completes; unique per branch. Totals are BigInt minor units; rounding is signed.
/// CHECKs (non-negative, discount within subtotal, paid covers total and numbered once COMPLETED/RETURNED_*) are in the
/// migration. The shift must be of the same branch (composite foreign key).
model PhSale {
  id            String       @id @default(cuid())
  restaurantId  String
  branchId      String
  shiftId       String
  number        String?
  status        PhSaleStatus @default(HELD)
  currency      Currency
  subtotalMinor BigInt       @default(0)
  discountMinor BigInt       @default(0)
  roundingMinor BigInt       @default(0)
  totalMinor    BigInt       @default(0)
  paidMinor     BigInt       @default(0)
  changeMinor   BigInt       @default(0)
  clientKey     String
  /// SHA-256 of the request that created the sale (canonical JSON), so a replayed `clientKey` can prove it is the same request.
  payloadHash   String?
  /// A HELD sale only: the cart exactly as it was entered (money as decimal text), so resuming gives it back unchanged. Null on every other sale.
  holdPayload   Json?
  soldById      String
  pharmacistId  String?
  /// The customer a credit sale is on the account of (R7-5); null for every other sale.
  customerId    String?
  heldUntil     DateTime?
  note          String       @default("")
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  customer      PhCustomer?  @relation(fields: [restaurantId, customerId], references: [restaurantId, id], onDelete: NoAction)
  shift         PhShift      @relation("PhSaleShift", fields: [shiftId, branchId], references: [id, branchId], onDelete: NoAction)
  shiftCurrency PhShift      @relation("PhSaleShiftCurrency", fields: [shiftId, currency], references: [id, currency], onDelete: NoAction)

  lines            PhSaleLine[]
  payments         PhPayment[]        @relation("PhPaymentSale")
  paymentCurrency  PhPayment[]        @relation("PhPaymentCurrency")
  returns          PhReturn[]         @relation("PhReturnSale")
  returnCurrencies PhReturn[]         @relation("PhReturnCurrency")
  reprints         PhReceiptReprint[]
  prescription     PhPrescription?
  controlledEntries PhControlledEntry[]
  ledgerEntries    PhCustomerLedger[]

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id])
  @@unique([restaurantId, id, branchId])
  @@unique([restaurantId, id, currency])
  @@unique([id, branchId])
  @@unique([id, currency])
  @@unique([branchId, number])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, branchId, completedAt])
  @@index([shiftId])
  @@index([restaurantId, customerId])
}

/// One line of a sale: `qty` of `unitId`, `baseQty` the same in base units, at the line's OWN `unitPriceMinor` (the price
/// row used is `priceId`, so a later price change never rewrites it). `rxLevel` is the product's level at sale time.
/// CHECKs (qty/baseQty >= 1, money >= 0, discount within qty x price) are in the migration. No `branchId`: reached
/// through the sale.
model PhSaleLine {
  id                  String        @id @default(cuid())
  restaurantId        String
  saleId              String
  lineNo              Int
  productId           String
  unitId              String
  priceId             String?
  qty                 Int
  baseQty             Int
  unitPriceMinor      BigInt
  discountMinor       BigInt        @default(0)
  totalMinor          BigInt
  rxLevel             PhRxLevel     @default(OTC)
  pharmacistId        String?
  priceOverrideReason String        @default("")
  discountReason      String        @default("")
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sale                PhSale        @relation(fields: [restaurantId, saleId], references: [restaurantId, id], onDelete: Cascade)
  product             PhProduct     @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  unit                PhProductUnit @relation(fields: [productId, unitId], references: [productId, id], onDelete: NoAction)
  price               PhPrice?      @relation(fields: [restaurantId, priceId], references: [restaurantId, id], onDelete: NoAction)

  allocations PhSaleLineAllocation[]
  controlledEntries PhControlledEntry[]

  @@unique([saleId, lineNo])
  @@unique([restaurantId, id])
  @@unique([restaurantId, saleId, id])
  @@index([restaurantId, productId])
}

/// The batch a sale line took stock from (FEFO or an override), with the cost and expiry at that moment. Returns raise
/// `returnedBaseQty` (CHECK 0..baseQty in the migration). `costSnapshotMinor` and `costCurrency` are both set or both null.
/// No `branchId`: reached through the sale line.
model PhSaleLineAllocation {
  id                String     @id @default(cuid())
  restaurantId      String
  saleLineId        String
  batchId           String
  baseQty           Int
  costSnapshotMinor BigInt?
  costCurrency      Currency?
  expirySnapshot    DateTime   @db.Date
  returnedBaseQty   Int        @default(0)
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  saleLine          PhSaleLine @relation(fields: [restaurantId, saleLineId], references: [restaurantId, id], onDelete: Cascade)
  batch             PhBatch    @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  returnLines PhReturnLine[]

  @@unique([restaurantId, id])
  @@index([saleLineId])
  @@index([restaurantId, batchId])
}

/// A payment of a sale, in the sale's currency (composite foreign key on (saleId, currency)); idempotent by `clientKey`
/// per business. `reference` holds the card/transfer slip text for the manual methods. No `branchId`: through the sale.
model PhPayment {
  id           String          @id @default(cuid())
  restaurantId String
  saleId       String
  method       PhPaymentMethod
  amountMinor  BigInt
  currency     Currency
  clientKey    String
  reference    String          @default("")
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sale         PhSale          @relation("PhPaymentSale", fields: [restaurantId, saleId], references: [restaurantId, id], onDelete: NoAction)
  saleCurrency PhSale          @relation("PhPaymentCurrency", fields: [saleId, currency], references: [id, currency], onDelete: NoAction)

  @@unique([restaurantId, clientKey])
  @@index([saleId])
}

/// A return (or a cancel) of a sale at the same branch, approved by someone with `return.approve`; the refund is in the
/// sale's currency and recorded as a cash movement of `shiftId` (a shift of the same branch, composite foreign key).
/// Numbered per branch; idempotent by `clientKey`.
model PhReturn {
  id            String          @id @default(cuid())
  restaurantId  String
  branchId      String
  saleId        String
  shiftId       String
  number        String?
  reason        String
  approvedById  String
  refundMethod  PhPaymentMethod
  refundMinor   BigInt
  /// The part of `refundMinor` taken off the customer's balance (phase 7, a credit sale); the rest (`refundMinor - creditMinor`) is handed back by `refundMethod`. CHECK 0..refundMinor.
  creditMinor   BigInt          @default(0)
  currency      Currency
  clientKey     String
  /// SHA-256 of the request that created the return (canonical JSON), so a replayed `clientKey` can prove it is the same request.
  payloadHash   String?
  createdAt     DateTime        @default(now())
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  sale          PhSale          @relation("PhReturnSale", fields: [saleId, branchId], references: [id, branchId], onDelete: NoAction)
  saleCurrency  PhSale          @relation("PhReturnCurrency", fields: [saleId, currency], references: [id, currency], onDelete: NoAction)
  shift         PhShift         @relation("PhReturnShift", fields: [shiftId, branchId], references: [id, branchId], onDelete: NoAction)
  shiftCurrency PhShift         @relation("PhReturnShiftCurrency", fields: [shiftId, currency], references: [id, currency], onDelete: NoAction)

  lines    PhReturnLine[]
  reprints PhReceiptReprint[]

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id])
  @@unique([branchId, number])
  @@index([restaurantId, branchId, createdAt])
  @@index([saleId])
}

/// What one return gives back from one sale line allocation (base units), with its refund. One row per allocation per
/// return. No `branchId`: through the return.
model PhReturnLine {
  id                   String               @id @default(cuid())
  restaurantId         String
  returnId             String
  saleLineAllocationId String
  baseQty              Int
  refundMinor          BigInt
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  return               PhReturn             @relation(fields: [restaurantId, returnId], references: [restaurantId, id], onDelete: Cascade)
  allocation           PhSaleLineAllocation @relation(fields: [restaurantId, saleLineAllocationId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([returnId, saleLineAllocationId])
  @@index([saleLineAllocationId])
}

/// One printed copy of a receipt after the first. Names a sale OR a return (CHECK "PhReceiptReprint_one_target");
/// `copyNumber` is unique per document. No `branchId`: through the sale or return.
model PhReceiptReprint {
  id           String     @id @default(cuid())
  restaurantId String
  saleId       String?
  returnId     String?
  userId       String
  copyNumber   Int
  /// Paper width printed: 80 or 58 (mm). CHECK in the migration.
  width        Int        @default(80)
  /// Makes a repeated reprint request return the copy already logged. Null on rows written before it existed.
  clientKey    String?
  /// Why the copy was printed (capped at 200 characters); never a customer or patient detail.
  reason       String     @default("")
  printedAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sale         PhSale?    @relation(fields: [restaurantId, saleId], references: [restaurantId, id], onDelete: NoAction)
  return       PhReturn?  @relation(fields: [restaurantId, returnId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([saleId, copyNumber])
  @@unique([returnId, copyNumber])
  @@unique([restaurantId, clientKey])
}

/// A plan of one application, with its features and limits (global catalog).
model AppPlan {
  id            String      @id @default(cuid())
  applicationId String
  code          String
  /// { en, ar, ckb }
  name          Json
  features      Json        @default("{}")
  limits        Json        @default("{}")
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, code])
}

/// A time-boxed, scoped grant that lets one platform user read a restaurant's data to give support.
model SupportAccessGrant {
  id               String     @id @default(cuid())
  restaurantId     String
  granteeUserId    String
  scopes           String[]
  reason           String
  approvedByUserId String?
  consentRef       String?
  startsAt         DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  grantee          User       @relation("SupportGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([granteeUserId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 4: purchasing. Suppliers, purchase orders, supplier invoices, payables, payments, returns and credit notes.
// Money is BigInt minor units with a currency beside it. The CHECKs, the partial unique indexes, the append-only triggers
// and the deferred total check are in the migration `20261029100000_pharmacy_purchasing`.
// ---------------------------------------------------------------------------------------------------------------------

enum PhPurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

enum PhSupplierInvoiceStatus {
  OPEN
  PARTIAL
  PAID
  VOID
}

enum PhSupplierPaymentMethod {
  CASH
  TRANSFER_MANUAL
  CHEQUE_MANUAL
  CARD_MANUAL
}

/// A supplier of the whole business (no branch). `nameKey` is the lower-cased trimmed name: one supplier per name per
/// business. Archived (`active = false`), never deleted. CHECK: `termsDays` 0..365.
model PhSupplier {
  id              String     @id @default(cuid())
  restaurantId    String
  name            String
  nameKey         String
  phone           String     @default("")
  contactName     String     @default("")
  addressNote     String     @default("")
  defaultCurrency Currency
  termsDays       Int        @default(0)
  active          Boolean    @default(true)
  note            String     @default("")
  clientKey       String
  payloadHash     String?
  createdById     String
  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  receipts       PhReceipt[]
  purchaseOrders PhPurchaseOrder[]
  invoices       PhSupplierInvoice[]
  payments       PhSupplierPayment[]
  returns        PhSupplierReturn[]
  intakeBatches  PhIntakeBatch[]
  creditNotes    PhCreditNote[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, nameKey])
  @@unique([restaurantId, clientKey])
  @@index([restaurantId, active, name])
}

/// An order to one supplier, for one branch, in one currency. `number` is given when it is ordered. Counters on its lines
/// (`receivedQty`, `receivedBonus`) are changed by the purchasing service only.
model PhPurchaseOrder {
  id           String                @id @default(cuid())
  restaurantId String
  branchId     String
  supplierId   String
  status       PhPurchaseOrderStatus @default(DRAFT)
  currency     Currency
  /// Per-branch running number ("PO-20261029-000001"), assigned when the order is placed.
  number       String?
  clientKey    String
  /// SHA-256 of the request that created the order, so a replayed `clientKey` can prove it is the same request.
  payloadHash  String?
  expectedOn   DateTime?             @db.Date
  note         String                @default("")
  orderedAt    DateTime?
  orderedById  String?
  closedAt     DateTime?
  closedById   String?
  closeReason  String                @default("")
  cancelledAt  DateTime?
  createdById  String
  version      Int                   @default(1)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  supplier     PhSupplier            @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)

  lines             PhPurchaseOrderLine[]
  receipts          PhReceipt[]          @relation("PhReceiptOrderBranch")
  receiptsOfSupplier PhReceipt[]         @relation("PhReceiptOrderSupplier")

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id])
  @@unique([restaurantId, id, branchId])
  @@unique([restaurantId, id, branchId, supplierId])
  @@unique([branchId, number])
  @@index([restaurantId, branchId, status, createdAt])
  @@index([restaurantId, supplierId])
}

/// One line of an order: `qtyOrdered` (+ `bonusOrdered`) of `unitId` at `unitCostMinor` per unit. `receivedQty` and
/// `receivedBonus` never pass what was ordered (CHECKs). No `branchId`: through the order.
model PhPurchaseOrderLine {
  id              String          @id @default(cuid())
  restaurantId    String
  purchaseOrderId String
  lineNo          Int
  productId       String
  unitId          String
  qtyOrdered      Int
  bonusOrdered    Int             @default(0)
  unitCostMinor   BigInt
  receivedQty     Int             @default(0)
  receivedBonus   Int             @default(0)
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchaseOrder   PhPurchaseOrder @relation(fields: [restaurantId, purchaseOrderId], references: [restaurantId, id], onDelete: Cascade)
  product         PhProduct       @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  unit            PhProductUnit   @relation(fields: [productId, unitId], references: [productId, id], onDelete: NoAction)

  receiptLines PhReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@unique([restaurantId, id])
  @@index([restaurantId, productId])
}

/// A supplier's invoice: a payable. `paidMinor` and `creditedMinor` are counters (CHECK: together within `totalMinor`),
/// changed by the payments service only. `totalMinor` = the lines + `adjustmentMinor` (a deferred constraint trigger).
/// `number` is normalised; `fingerprint` stops the same invoice being entered twice.
model PhSupplierInvoice {
  id               String                  @id @default(cuid())
  restaurantId     String
  supplierId       String
  number           String
  numberRaw        String
  invoiceDate      DateTime                @db.Date
  dueDate          DateTime                @db.Date
  currency         Currency
  adjustmentMinor  BigInt                  @default(0)
  adjustmentReason String                  @default("")
  totalMinor       BigInt
  paidMinor        BigInt                  @default(0)
  creditedMinor    BigInt                  @default(0)
  status           PhSupplierInvoiceStatus @default(OPEN)
  fingerprint      String
  clientKey        String
  payloadHash      String?
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String                  @default("")
  createdById      String
  version          Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  restaurant       Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier         PhSupplier              @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)

  lines              PhSupplierInvoiceLine[]
  paymentAllocations PhSupplierPaymentAllocation[]
  creditAllocations  PhCreditAllocation[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, supplierId, currency])
  @@unique([restaurantId, supplierId, number])
  @@unique([restaurantId, fingerprint])
  @@unique([restaurantId, clientKey])
  @@index([restaurantId, supplierId, status, dueDate])
}

/// What an invoice bills of one received line. `lineTotalMinor` = `qtyInvoiced` * `unitCostMinor` (CHECK).
model PhSupplierInvoiceLine {
  id             String            @id @default(cuid())
  restaurantId   String
  invoiceId      String
  lineNo         Int
  receiptLineId  String
  qtyInvoiced    Int
  unitCostMinor  BigInt
  lineTotalMinor BigInt
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice        PhSupplierInvoice @relation(fields: [restaurantId, invoiceId], references: [restaurantId, id], onDelete: Cascade)
  receiptLine    PhReceiptLine     @relation(fields: [restaurantId, receiptLineId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([invoiceId, lineNo])
  @@index([restaurantId, receiptLineId])
}

/// Money paid to a supplier. Append-only (a trigger refuses UPDATE and DELETE): a mistake is a reversal row
/// (`isReversal`, `reversesId`), once per payment, of the same supplier and currency, holding the original's amount.
model PhSupplierPayment {
  id           String                  @id @default(cuid())
  restaurantId String
  supplierId   String
  currency     Currency
  method       PhSupplierPaymentMethod
  amountMinor  BigInt
  paidOn       DateTime                @db.Date
  reference    String                  @default("")
  clientKey    String
  payloadHash  String?
  isReversal   Boolean                 @default(false)
  reversesId   String?
  createdById  String
  createdAt    DateTime                @default(now())
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier     PhSupplier              @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  reverses     PhSupplierPayment?      @relation("PhSupplierPaymentReversal", fields: [restaurantId, reversesId, supplierId, currency], references: [restaurantId, id, supplierId, currency], onDelete: NoAction)

  reversedBy  PhSupplierPayment[] @relation("PhSupplierPaymentReversal")
  allocations PhSupplierPaymentAllocation[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, supplierId, currency])
  @@unique([restaurantId, clientKey])
  @@index([restaurantId, supplierId, paidOn])
}

/// How much of a payment went to one invoice. Carries the supplier and currency so that both composite foreign keys
/// prove they match. Append-only.
model PhSupplierPaymentAllocation {
  id           String            @id @default(cuid())
  restaurantId String
  paymentId    String
  invoiceId    String
  supplierId   String
  currency     Currency
  amountMinor  BigInt
  createdAt    DateTime          @default(now())
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  payment      PhSupplierPayment @relation(fields: [restaurantId, paymentId, supplierId, currency], references: [restaurantId, id, supplierId, currency], onDelete: NoAction)
  invoice      PhSupplierInvoice @relation(fields: [restaurantId, invoiceId, supplierId, currency], references: [restaurantId, id, supplierId, currency], onDelete: NoAction)

  @@unique([paymentId, invoiceId])
  @@index([restaurantId, invoiceId])
}

/// Stock sent back to a supplier from one branch. Created confirmed; `reason` may not be empty (CHECK).
model PhSupplierReturn {
  id           String     @id @default(cuid())
  restaurantId String
  branchId     String
  supplierId   String
  number       String?
  reason       String
  note         String     @default("")
  clientKey    String
  payloadHash  String?
  createdById  String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  supplier     PhSupplier @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)

  lines       PhSupplierReturnLine[]
  creditNotes PhCreditNote[]

  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id])
  @@unique([branchId, number])
  @@index([restaurantId, branchId, createdAt])
  @@index([restaurantId, supplierId])
}

/// One batch taken back (base units) from the `AVAILABLE` or `QUARANTINE` bucket (CHECK), with the batch's cost copied
/// (both the cost and its currency, or neither). No `branchId`: through the return.
model PhSupplierReturnLine {
  id            String           @id @default(cuid())
  restaurantId  String
  returnId      String
  lineNo        Int
  batchId       String
  bucket        PhStockBucket
  qty           Int
  unitCostMinor BigInt?
  costCurrency  Currency?
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  return        PhSupplierReturn @relation(fields: [restaurantId, returnId], references: [restaurantId, id], onDelete: Cascade)
  batch         PhBatch          @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([returnId, lineNo])
  @@index([restaurantId, batchId])
}

/// A credit note from a supplier: `number` is the supplier's own (normalised). `appliedMinor` is what invoices have taken
/// of it (CHECK 0..amount), changed by the payments service only.
model PhCreditNote {
  id               String            @id @default(cuid())
  restaurantId     String
  supplierId       String
  number           String
  currency         Currency
  amountMinor      BigInt
  appliedMinor     BigInt            @default(0)
  noteDate         DateTime          @db.Date
  supplierReturnId String?
  note             String            @default("")
  clientKey        String
  payloadHash      String?
  createdById      String
  createdAt        DateTime          @default(now())
  restaurant       Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier         PhSupplier        @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  supplierReturn   PhSupplierReturn? @relation(fields: [restaurantId, supplierReturnId], references: [restaurantId, id], onDelete: NoAction)

  allocations PhCreditAllocation[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, supplierId, currency])
  @@unique([restaurantId, supplierId, number])
  @@unique([restaurantId, clientKey])
}

/// How much of a credit note was set against one invoice (same supplier and currency by the two composite keys). Append-only.
model PhCreditAllocation {
  id           String            @id @default(cuid())
  restaurantId String
  creditNoteId String
  invoiceId    String
  supplierId   String
  currency     Currency
  amountMinor  BigInt
  /// The request that made this row (one request writes one row per invoice): a repeat of it is a replay. Null on rows made before.
  clientKey    String?
  payloadHash  String?
  createdById  String?
  createdAt    DateTime          @default(now())
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  creditNote   PhCreditNote      @relation(fields: [restaurantId, creditNoteId, supplierId, currency], references: [restaurantId, id, supplierId, currency], onDelete: NoAction)
  invoice      PhSupplierInvoice @relation(fields: [restaurantId, invoiceId, supplierId, currency], references: [restaurantId, id, supplierId, currency], onDelete: NoAction)

  @@unique([creditNoteId, invoiceId])
  @@index([restaurantId, invoiceId])
  @@index([restaurantId, clientKey])
}

enum PhIntakeBatchStatus {
  OPEN
  APPROVED
  CANCELLED
}

enum PhIntakeFileStatus {
  UPLOADED
  REJECTED_QUALITY
  EXTRACTING
  EXTRACTED
  FAILED
  PURGED
}

/// Phase 5. Invoice intake: a batch of supplier-invoice photos or PDFs read by the AI into rows a person reviews. Intake
/// never writes stock; approval creates a DRAFT receipt (`receiptId`, one batch per receipt). `header` is the extracted
/// invoice header (number, date, total, currency), `{}` when none. CHECK: APPROVED needs a receipt and `approvedAt`.
model PhIntakeBatch {
  id           String              @id @default(cuid())
  restaurantId String
  branchId     String
  supplierId   String?
  status       PhIntakeBatchStatus @default(OPEN)
  header       Json                @default("{}")
  receiptId    String?
  clientKey    String
  payloadHash  String
  createdById  String
  approvedAt   DateTime?
  approvedById String?
  cancelledAt  DateTime?
  version      Int                 @default(1)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  supplier     PhSupplier?         @relation(fields: [restaurantId, supplierId], references: [restaurantId, id], onDelete: NoAction)
  receipt      PhReceipt?          @relation(fields: [restaurantId, receiptId], references: [restaurantId, id], onDelete: NoAction)
  receiptBranch PhReceipt?         @relation("PhIntakeBatchReceiptBranch", fields: [restaurantId, receiptId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)
  files        PhIntakeFile[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, receiptId])
  @@index([restaurantId, branchId, status, createdAt])
}

/// One uploaded file of a batch. `sha256` is unique per business (the same file twice returns the first). `storageKey`
/// is blanked when the file is purged after its retention; the row data stays. CHECKs (sha format, media type, bytes
/// 1..8 MiB, pages 1..10, PURGED has no key, a failure code only on FAILED or REJECTED_QUALITY) are in the migration.
model PhIntakeFile {
  id           String             @id @default(cuid())
  restaurantId String
  batchId      String
  sha256       String
  storageKey   String?
  mediaType    String
  bytes        Int
  pages        Int
  quality      Json               @default("{}")
  status       PhIntakeFileStatus @default(UPLOADED)
  failureCode  String?
  attempts     Int                @default(0)
  extractedAt  DateTime?
  /// Set while status is EXTRACTING (CHECK): the lease a worker holds; an older one can be reclaimed.
  extractingSince DateTime?
  expiresAt    DateTime
  uploadedById String
  createdAt    DateTime           @default(now())
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  batch        PhIntakeBatch      @relation(fields: [restaurantId, batchId], references: [restaurantId, id], onDelete: Cascade)
  rows         PhIntakeRow[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, sha256])
  @@index([restaurantId, batchId])
  @@index([status, expiresAt])
  @@index([restaurantId, status, extractingSince])
}

/// One line the AI read (`extracted`, as returned after validation) and what the reviewer made of it (`edited`). The
/// matched product and unit go together (CHECK) and are of the same business by the composite keys.
model PhIntakeRow {
  id               String         @id @default(cuid())
  restaurantId     String
  fileId           String
  lineNo           Int
  page             Int
  extracted        Json
  edited           Json           @default("{}")
  matchedProductId String?
  matchedUnitId    String?
  /// MATCHED, UNMATCHED, AMBIGUOUS or CHOSEN (CHECK in the migration); a CHOSEN line is never rematched.
  matchState       String         @default("UNMATCHED")
  /// [{ productId, score }]: at most 5 products the matcher offers; names are read when shown.
  candidates       Json           @default("[]")
  /// What the reviewer acknowledged, with the flag set and difference they saw: { flags?, mismatch? }.
  acknowledged     Json           @default("{}")
  version          Int            @default(1)
  lastKey          String?
  lastKeyHash      String?
  flags            String[]       @default([])
  reviewed         Boolean        @default(false)
  note             String?
  restaurant       Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  file             PhIntakeFile   @relation(fields: [restaurantId, fileId], references: [restaurantId, id], onDelete: Cascade)
  product          PhProduct?     @relation(fields: [restaurantId, matchedProductId], references: [restaurantId, id], onDelete: NoAction)
  unit             PhProductUnit? @relation(fields: [matchedProductId, matchedUnitId], references: [productId, id], onDelete: NoAction)

  @@unique([restaurantId, id])
  @@unique([fileId, lineNo])
  @@index([restaurantId, matchedProductId])
}

/// What a business spent on the pharmacy AI in one Baghdad month, in micro-dollars. `reservedMicroUsd` is the worst case
/// held for calls in flight; it is settled into `spentMicroUsd`. CHECK: `month` is YYYY-MM, every count is >= 0.
model PhAiUsageMonth {
  id               String     @id @default(cuid())
  restaurantId     String
  month            String
  spentMicroUsd    BigInt     @default(0)
  reservedMicroUsd BigInt     @default(0)
  calls            Int        @default(0)
  inputTokens      BigInt     @default(0)
  outputTokens     BigInt     @default(0)
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations     PhAiReservation[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, month])
}

/// One open budget reservation: the worst case held in `PhAiUsageMonth.reservedMicroUsd` for a file's extraction. One
/// per file (unique), deleted when it is settled; a sweeper releases the ones left by a crash. CHECK: microUsd > 0.
model PhAiReservation {
  id           String           @id @default(cuid())
  restaurantId String
  month        String
  microUsd     BigInt
  fileId       String
  createdAt    DateTime         @default(now())
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  usage        PhAiUsageMonth   @relation(fields: [restaurantId, month], references: [restaurantId, month], onDelete: NoAction)

  @@unique([restaurantId, id])
  @@unique([restaurantId, fileId])
  @@index([restaurantId, createdAt])
}

/// One call to the AI, metadata only (no prompt, no answer). Append-only. `fileId` is plain text: it outlives a purge.
model PhAiCall {
  id           String     @id @default(cuid())
  restaurantId String
  purpose      String
  model        String
  inputTokens  Int?
  outputTokens Int?
  ms           Int?
  status       String
  costMicroUsd BigInt     @default(0)
  fileId       String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, id])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, fileId])
}

enum PhTransferStatus {
  REQUESTED
  SENT
  RECEIVED
  PARTIAL
  CANCELLED
}

enum PhTransferLostReason {
  LOST
  OTHER
}

/// A movement of stock between two different branches of one business. REQUESTED -> SENT -> RECEIVED | PARTIAL, or
/// CANCELLED from REQUESTED only. Stock leaves the sender with a TRANSFER_OUT when it is sent and enters the destination
/// with a TRANSFER_IN when it is received; in between, "in transit" is derived from the open lines (R6-2), not a bucket.
/// `number` is a per-sending-branch running number given when the transfer is requested. It has no `branchId`: it names two
/// branches, so the tenant client confines it by either end (`PHARMACY_EITHER_BRANCH_MODELS`). CHECKs (two branches, the
/// status/timestamp implications, note length) are in the migration.
model PhTransfer {
  id            String           @id @default(cuid())
  restaurantId  String
  fromBranchId  String
  toBranchId    String
  status        PhTransferStatus @default(REQUESTED)
  number        String?
  clientKey     String
  payloadHash   String
  note          String           @default("")
  requestedById String
  requestedAt   DateTime         @default(now())
  sentById      String?
  sentAt        DateTime?
  receivedById  String?
  receivedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  sendKey       String?
  sendHash      String?
  sendOverride  Boolean          @default(false)
  receiveKey    String?
  receiveHash   String?
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fromBranch    Branch           @relation("PhTransferFrom", fields: [restaurantId, fromBranchId], references: [restaurantId, id], onDelete: NoAction)
  toBranch      Branch           @relation("PhTransferTo", fields: [restaurantId, toBranchId], references: [restaurantId, id], onDelete: NoAction)
  lines         PhTransferLine[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, clientKey])
  @@unique([restaurantId, id, fromBranchId, toBranchId])
  @@unique([restaurantId, sendKey])
  @@unique([restaurantId, receiveKey])
  @@unique([fromBranchId, number])
  @@index([restaurantId, fromBranchId, status])
  @@index([restaurantId, toBranchId, status])
  @@index([restaurantId, status, sentAt])
  @@index([restaurantId, requestedAt])
}

/// A line of a transfer, in whole base units. Two kinds, told apart by `requestLineId`: a REQUEST line (no batch, no request
/// line, `requestedQty >= 1`, nothing sent) is the record of what was asked for a product and never changes; a SENT line (one per
/// batch FEFO took from, `requestLineId` set, `requestedQty` 0, `sentQty >= 1`) is created when the transfer is sent, and only
/// its receive columns change after that. `fromBranchId`/`toBranchId` copy the parent's ends (composite FK), so the line is
/// confined to the same two branches as its transfer. CHECKs and triggers are in the migrations.
model PhTransferLine {
  id            String                @id @default(cuid())
  restaurantId  String
  transferId    String
  fromBranchId  String
  toBranchId    String
  lineNo        Int
  productId     String
  batchId       String?
  requestLineId String?
  requestedQty  Int
  sentQty       Int                   @default(0)
  receivedQty   Int                   @default(0)
  lostQty       Int                   @default(0)
  damagedQty    Int                   @default(0)
  lostReason    PhTransferLostReason?
  quarantine    Boolean               @default(false)
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  transfer      PhTransfer            @relation(fields: [restaurantId, transferId, fromBranchId, toBranchId], references: [restaurantId, id, fromBranchId, toBranchId], onDelete: Cascade)
  product       PhProduct             @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  batch         PhBatch?              @relation(fields: [restaurantId, productId, batchId], references: [restaurantId, productId, id], onDelete: NoAction)
  requestLine   PhTransferLine?       @relation("PhTransferLineRequest", fields: [restaurantId, transferId, requestLineId], references: [restaurantId, transferId, id], onDelete: NoAction)
  sentLines     PhTransferLine[]      @relation("PhTransferLineRequest")

  @@unique([restaurantId, id])
  @@unique([restaurantId, transferId, id])
  @@unique([transferId, lineNo])
  @@index([restaurantId, batchId])
  @@index([restaurantId, productId])
  @@index([restaurantId, transferId, requestLineId])
  @@index([requestLineId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Phase 7: prescriptions and controlled drugs, credit sales, assistant proposals. Additive migration
// 20261101100000_pharmacy_phase7; the CHECKs, the partial unique indexes and the append-only triggers are in it.
// ---------------------------------------------------------------------------------------------------------------------

enum PhControlledKind {
  SALE
  RETURN
}

enum PhCustomerPaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PhCustomerLedgerKind {
  CHARGE
  PAYMENT
  REVERSAL
  REFUND
}

enum PhAiProposalKind {
  TRANSFER
  REORDER
  SUPPLIER_RETURN
}

enum PhAiProposalStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

/// A prescription seen at the counter, of one branch (R7-2). Created before its sale completes (`saleId` null) and tied to the
/// sale of the SAME branch when it does (composite foreign key; one prescription per sale, one sale per prescription).
/// Idempotent by `clientKey`. `number` is what the paper says and is NOT unique: pads repeat across prescribers and years. The
/// rule "a controlled drug's prescription number is not reused for the same product within its validity window"
/// (`DUPLICATE_PRESCRIPTION`) is checked by the service over `PhControlledEntry` (index on (restaurantId, number)).
/// `patientIdNote` is a document type plus its last 4 characters, never a full number. Patient and prescriber fields never enter
/// the audit log. CHECKs in the migration.
model PhPrescription {
  id                String     @id @default(cuid())
  restaurantId      String
  branchId          String
  number            String
  prescriberName    String
  prescriberLicense String?
  patientName       String?
  patientIdNote     String?
  issuedOn          DateTime   @db.Date
  saleId            String?
  clientKey         String
  payloadHash       String
  createdById       String
  createdAt         DateTime   @default(now())
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch            Branch     @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  sale              PhSale?    @relation(fields: [restaurantId, saleId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)

  attachments PhRxAttachment[]
  entries     PhControlledEntry[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, branchId])
  @@unique([restaurantId, clientKey])
  @@unique([saleId])
  @@unique([restaurantId, saleId, branchId])
  @@index([restaurantId, number])
  @@index([restaurantId, branchId, createdAt])
}

/// A scan or photo of a prescription (R7-3), kept in the private store under `storageKey` (never a public URL). `branchId` copies
/// the prescription's (composite foreign key) so a branch-limited client confines it. CHECKs: size 1..5 MB, mime image/* or PDF,
/// sha256 is 64 hex characters.
model PhRxAttachment {
  id             String         @id @default(cuid())
  restaurantId   String
  branchId       String
  prescriptionId String
  storageKey     String         @unique
  mime           String
  sizeBytes      Int
  sha256         String
  uploadedById   String
  createdAt      DateTime       @default(now())
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  prescription   PhPrescription @relation(fields: [restaurantId, prescriptionId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)

  @@unique([restaurantId, id])
  @@index([restaurantId, prescriptionId])
}

/// The controlled-drug register (R7-1): append-only (a trigger refuses UPDATE and DELETE; a whole-business delete cascades). One
/// row per batch a controlled sale line took from: `baseQty` is signed (SALE > 0, RETURN < 0, never 0). No `updatedAt`.
/// The line must belong to the sale, the sale and the prescription to the branch, the batch to the product (composite foreign keys).
model PhControlledEntry {
  id             String           @id @default(cuid())
  restaurantId   String
  branchId       String
  saleId         String
  saleLineId     String
  productId      String
  batchId        String
  prescriptionId String
  baseQty        Int
  kind           PhControlledKind
  dispensedById  String
  createdAt      DateTime         @default(now())
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch           @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  sale           PhSale           @relation(fields: [restaurantId, saleId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)
  saleLine       PhSaleLine       @relation(fields: [restaurantId, saleId, saleLineId], references: [restaurantId, saleId, id], onDelete: NoAction)
  product        PhProduct        @relation(fields: [restaurantId, productId], references: [restaurantId, id], onDelete: NoAction)
  batch          PhBatch          @relation(fields: [restaurantId, productId, batchId], references: [restaurantId, productId, id], onDelete: NoAction)
  prescription   PhPrescription   @relation(fields: [restaurantId, prescriptionId, branchId], references: [restaurantId, id, branchId], onDelete: NoAction)

  @@unique([restaurantId, id])
  @@index([restaurantId, branchId, productId, createdAt])
  @@index([restaurantId, prescriptionId])
  @@index([restaurantId, saleLineId])
}

/// A customer with an account (R7-5), business-wide, in ONE currency (the ledger and payments are pinned to it by composite
/// foreign keys, so a balance is never mixed or converted). `phone` is private (shown with `customer.manage`). CHECKs: limit >= 0,
/// name not empty.
model PhCustomer {
  id               String     @id @default(cuid())
  restaurantId     String
  name             String
  phone            String?
  creditLimitMinor BigInt     @default(0)
  currency         Currency
  active           Boolean    @default(true)
  note             String     @default("")
  version          Int        @default(1)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  sales    PhSale[]
  ledger   PhCustomerLedger[]
  payments PhCustomerPayment[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, currency])
  @@index([restaurantId, name])
}

/// What a customer owes, as signed rows (R7-5): the BALANCE IS THE SUM of `amountMinor` per customer (no stored balance).
/// CHARGE > 0 (a credit sale; one per sale), PAYMENT < 0 (a payment row, one ledger row per payment), REVERSAL (the reversing
/// payment row: the opposite sign of what it reverses, never 0), REFUND < 0 (a return reduces the debt). Charge and refund name
/// their sale, payment and reversal their payment (composite foreign keys pin customer, currency and business). Append-only.
model PhCustomerLedger {
  id           String               @id @default(cuid())
  restaurantId String
  customerId   String
  kind         PhCustomerLedgerKind
  amountMinor  BigInt
  currency     Currency
  saleId       String?
  paymentId    String?
  createdAt    DateTime             @default(now())
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     PhCustomer           @relation(fields: [restaurantId, customerId, currency], references: [restaurantId, id, currency], onDelete: NoAction)
  sale         PhSale?              @relation(fields: [restaurantId, saleId, currency], references: [restaurantId, id, currency], onDelete: NoAction)
  payment      PhCustomerPayment?   @relation(fields: [restaurantId, paymentId, customerId, currency], references: [restaurantId, id, customerId, currency], onDelete: NoAction)

  @@unique([paymentId])
  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, saleId])
}

/// Money a customer paid toward their account, at one branch (R7-5). Append-only (a trigger refuses UPDATE and DELETE): a mistake
/// is a reversing row (`reversesId`, once per payment, same customer and currency, holding the original's amount). Idempotent by
/// `clientKey` + `payloadHash`. A CASH payment belongs to an open shift of the same branch (`shiftId`). CHECK: amount > 0.
model PhCustomerPayment {
  id           String                  @id @default(cuid())
  restaurantId String
  branchId     String
  customerId   String
  method       PhCustomerPaymentMethod
  amountMinor  BigInt
  currency     Currency
  clientKey    String
  payloadHash  String
  shiftId      String?
  reversesId   String?
  createdById  String
  createdAt    DateTime                @default(now())
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch                  @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)
  customer     PhCustomer              @relation(fields: [restaurantId, customerId, currency], references: [restaurantId, id, currency], onDelete: NoAction)
  shift        PhShift?                @relation(fields: [shiftId, branchId], references: [id, branchId], onDelete: NoAction)
  reverses     PhCustomerPayment?      @relation("PhCustomerPaymentReversal", fields: [restaurantId, reversesId, customerId, currency], references: [restaurantId, id, customerId, currency], onDelete: NoAction)

  reversedBy PhCustomerPayment[] @relation("PhCustomerPaymentReversal")
  ledger     PhCustomerLedger[]

  @@unique([restaurantId, id])
  @@unique([restaurantId, id, customerId, currency])
  @@unique([restaurantId, clientKey])
  @@unique([reversesId])
  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, branchId, createdAt])
  @@index([shiftId])
}

/// What the assistant suggested (R7-7): a proposal only, never an action. Accepting hands the person to the existing draft
/// creation. `payload` holds product ids and quantities, never patient or customer data. CHECK: decided (`decidedAt`) exactly
/// when the status is not PROPOSED.
model PhAiProposal {
  id           String             @id @default(cuid())
  restaurantId String
  branchId     String
  kind         PhAiProposalKind
  payload      Json
  status       PhAiProposalStatus @default(PROPOSED)
  createdById  String
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [restaurantId, branchId], references: [restaurantId, id], onDelete: NoAction)

  @@unique([restaurantId, id])
  @@index([restaurantId, branchId, status, createdAt])
}

/// The intro page shown before the menu (docs/superpowers/specs/2026-10-29-menu-intro-design.md). One per menu.
model MenuIntro {
  id                String   @id @default(cuid())
  menuId            String   @unique
  /// A picture or MP4 (with its poster) from the media library; null falls back to the platform's default, then to the brand colour.
  backgroundAssetId String?
  /// How dark the gradient over the background is, 0 to 100.
  overlay           Int      @default(50)
  showLogo          Boolean  @default(true)
  showContact       Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

/// An advert the platform shows on the intro pages of every restaurant, or only of the ones listed.
model PlatformAdvert {
  id            String    @id @default(cuid())
  imageAssetId  String
  alts          Json      @default("{}")
  href          String    @default("")
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  /// Both lists empty means every menu; otherwise the advert shows in a menu whose restaurant is listed or that is listed itself.
  restaurantIds String[]
  menuIds       String[]
  createdAt     DateTime  @default(now())
}

/// How often a platform advert was seen and clicked in a menu on a day: counts only, no person, address or cookie.
/// Global (no tenant scope): the Super Admin reads it across restaurants. Rows go when the advert goes.
model PlatformAdvertDaily {
  id           String   @id @default(cuid())
  advertId     String
  /// The menu and restaurant the advert was shown on (not tenant columns: the platform reads these across all restaurants).
  shownMenuId       String
  shownRestaurantId String
  /// YYYY-MM-DD in UTC.
  day          String
  views        Int      @default(0)
  clicks       Int      @default(0)

  @@unique([advertId, shownMenuId, day])
  @@index([day])
  @@index([shownRestaurantId, day])
}

/// The background intro pages use when a restaurant sets none. A single row, id 'singleton'.
model PlatformIntro {
  id                String   @id
  backgroundAssetId String?
  updatedAt         DateTime @updatedAt
}

/// The restaurant's own page inside the menu, shown to guests as "Explore" unless a title is set (docs/superpowers/specs/2026-10-29-menu-about-tab-design.md). One per menu.
model MenuAbout {
  id              String   @id @default(cuid())
  menuId          String   @unique
  /// { en?, ar?, ckb? }; empty falls back to the guest message "Explore".
  titles          Json     @default("{}")
  coverAssetId    String?
  /// { en?, ar?, ckb? } to a list of story blocks (heading, paragraph, list), validated by cleanStory.
  story           Json     @default("{}")
  galleryAssetIds String[]
  showHours       Boolean  @default(true)
  showContact     Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

/// A unique offer or discount card on the About page. Information only: it moves no price.
model AboutOffer {
  id           String    @id @default(cuid())
  menuId       String
  /// { en?, ar?, ckb? } each
  titles       Json      @default("{}")
  bodies       Json      @default("{}")
  label        Json      @default("{}")
  imageAssetId String?
  startsAt     DateTime?
  endsAt       DateTime?
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  /// At most one of these; both are ids of this menu's own product or category.
  productId    String?
  categoryId   String?
  createdAt    DateTime  @default(now())

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, sortOrder])
}

/// The wheel of fortune inside the Explore page (docs/superpowers/specs/2026-10-29-menu-wheel-of-fortune-design.md). One per menu.
model MenuWheel {
  id          String    @id @default(cuid())
  menuId      String    @unique
  /// Spins one guest may make a day (1 to 10); an address may make three times as many.
  spinsPerDay Int       @default(1)
  startsAt    DateTime?
  endsAt      DateTime?
  /// { en?, ar?, ckb? }
  title       Json      @default("{}")
  updatedAt   DateTime  @updatedAt

  menu   Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  slices WheelSlice[]
}

/// A dish on the wheel. The product is one of this menu's; it is skipped at spin time when hidden, unavailable or gone.
model WheelSlice {
  id        String @id @default(cuid())
  wheelId   String
  menuId    String
  productId String
  /// An optional prize line such as "10% off today": information only.
  label     Json   @default("{}")
  weight    Int    @default(1)
  sortOrder Int    @default(0)

  wheel MenuWheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  menu  Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([wheelId, productId])
  @@index([menuId])
}

/// One spin, kept for three days to count a guest's and an address's spins of the day. No personal data: a random cookie key and a salted hash.
model WheelSpin {
  id        String   @id @default(cuid())
  menuId    String
  guestKey  String
  ipHash    String
  /// YYYY-MM-DD in the menu's time zone.
  day       String
  /// 0 for a guest's first spin of the day, 1 for the second; unique with the guest and day, so two spins at once cannot both take the last one.
  slot      Int
  createdAt DateTime @default(now())

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, day, guestKey, slot])
  @@index([menuId, day, ipHash])
  @@index([createdAt])
}

/// How many times guests opened a dish, from the first day. Counted once per device and day, at most three per address and day (ProductViewMark); nobody edits it.
model ProductViewTotal {
  id        String   @id @default(cuid())
  menuId    String
  /// A plain id (no relation): a deleted dish never blocks anything.
  productId String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, productId])
}

/// Who has been counted for a dish today, kept three days. No personal data: a signed random cookie key and a salted address hash.
model ProductViewMark {
  id        String   @id @default(cuid())
  menuId    String
  productId String
  /// YYYY-MM-DD in the menu's time zone.
  day       String
  guestKey  String
  ipHash    String
  createdAt DateTime @default(now())

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, productId, day, guestKey])
  @@index([menuId, productId, day, ipHash])
  @@index([createdAt])
}
