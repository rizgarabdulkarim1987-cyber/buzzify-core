{
  "name": "buzzify-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:e2e": "playwright test",
    "perf": "tsx scripts/perf.ts",
    "styles:posters": "tsx scripts/menu-style-posters.ts",
    "media:calibrate": "tsx scripts/media-calibrate.ts",
    "studio:create-admin": "tsx scripts/create-admin.ts",
    "studio:set-platform-owner": "tsx scripts/set-platform-owner.ts",
    "studio:stage-models": "tsx scripts/set-stage-models.ts",
    "studio:template": "tsx scripts/set-template.ts",
    "studio:photos": "tsx scripts/attach-photos.ts",
    "studio:thumbnails": "playwright test --config playwright.thumbnails.config.ts",
    "db:up": "tsx scripts/db.ts up",
    "db:down": "tsx scripts/db.ts down",
    "db:start": "tsx scripts/db.ts start",
    "db:status": "tsx scripts/db.ts status",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:load": "tsx prisma/seed-load.ts",
    "vercel-build": "tsx scripts/check-env.ts && prisma generate && prisma migrate deploy && next build",
    "build:host": "tsx scripts/check-env.ts && prisma migrate deploy && BUILD_TARGET=standalone next build --webpack",
    "postinstall": "prisma generate"
  },
